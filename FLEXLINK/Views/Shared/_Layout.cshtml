<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FLEXLINK</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Membership.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FLEXLINK.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        /* CSS for the Sidebar Layout when logged in */
        .app-container {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            background-color: #000;
            color: #fff;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 1.5rem 1rem;
        }

            .sidebar .nav-link {
                color: #ccc !important;
                padding: 0.6rem 1rem;
                border-radius: 6px;
                margin-bottom: 0.25rem;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    color: #fff !important;
                    background-color: rgba(255, 255, 255, 0.1);
                }

        .main-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            background-color: #f8f9fa;
        }

        .page-body {
            flex-grow: 1;
            padding: 2rem;
        }
    </style>
</head>
<body>

    @if (User.Identity.IsAuthenticated)
    {
        <!-- LOGGED IN USER: SIDEBAR LAYOUT -->
        <div class="app-container">
            <!-- Sidebar Navigation -->
            <aside class="sidebar">
                <div>
                    <a class="d-flex align-items-center mb-4 text-decoration-none text-white px-2" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo.png" alt="FLEXLINK" style="max-height: 35px;" />
                    </a>

                    <ul class="nav nav-pills flex-column mb-auto">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Admin Panel</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Trainers"><i class="bi bi-person-badge me-2"></i>Trainers</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2"></i>Users</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Equipment"><i class="bi bi-wrench me-2"></i>Equipment</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Income"><i class="bi bi-cash-stack me-2"></i>Income</a>
                            </li>
                        }
                        else if (User.IsInRole("Trainer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Trainer" asp-action="EditProfile"><i class="bi bi-person-circle me-2"></i>Profile</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Trainer" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Trainer Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Trainer" asp-action="MySchedule"><i class="bi bi-calendar-event me-2"></i>Schedule</a>
                            </li>
                        }
                        else if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Staff" asp-action="Index"><i class="bi bi-people me-2"></i>Staffers</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Staff" asp-action="SpaceCapacity"><i class="bi bi-check-square me-2"></i>Registration Approval</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Trainer"><i class="bi bi-person-badge me-2"></i>Trainer</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Membership"><i class="bi bi-card-heading me-2"></i>Membership</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Schedule"><i class="bi bi-calendar-event me-2"></i>Schedule</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="UserProfile"><i class="bi bi-person-circle me-2"></i>Profile</a>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Logout Bottom Section -->
                <div class="border-top border-secondary pt-3 px-2">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light w-100 text-start">
                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                        </button>
                    </form>
                </div>
            </aside>

            <!-- Main Content Area -->
            <div class="main-content">
                <div class="page-body">
                    @RenderBody()
                </div>
                <footer class="border-top footer text-muted py-3 px-4 bg-white">
                    <div class="container-fluid">
                        &copy; 2026 - FLEXLINK - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </div>
                </footer>
            </div>
        </div>
    }
    else
    {
        <!-- GUEST / LANDING PAGE: TOP NAV LAYOUT -->
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3 flexlink-navbar">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo.png" alt="FLEXLINK" />
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="About">About Us</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                            </li>
                        </ul>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>

        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - FLEXLINK - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
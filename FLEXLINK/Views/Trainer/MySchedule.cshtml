@model IEnumerable<FLEXLINK.Models.TrainerSchedule>
@{
    ViewData["Title"] = "My Schedule";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <link rel="stylesheet" href="~/css/Trainer_Schedule.css" />
</head>

<div class="container">
<div class="schedule-page-container">
    <!-- Title Section -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1" style="color: #ffffff; font-size: 2rem;">My Schedule</h2>
        <p class="mb-0" style="color: #a0a0a0; font-size: 0.95rem;">Manage your session availability</p>
    </div>

    @* Success / Error alerts *@
    @if (TempData["ScheduleSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 bg-success text-white">
            @TempData["ScheduleSuccess"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ScheduleError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 bg-danger text-white">
            @TempData["ScheduleError"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header Actions Row: Filter Badges on Left, Action Button on Right -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <!-- Filter Badges -->
        <div class="d-flex gap-2 flex-wrap align-items-center">
            @{
                var historySlots = Model?.Count(s => s.ScheduleDate.Add(s.EndTime) < DateTime.Now) ?? 0;
                var bookedSlots = Model?.Count(s => s.IsBooked && s.ScheduleDate.Add(s.EndTime) >= DateTime.Now) ?? 0;
                var freeSlots = Model?.Count(s => !s.IsBooked && s.ScheduleDate.Add(s.EndTime) >= DateTime.Now) ?? 0;
                var upcomingSlots = bookedSlots + freeSlots;
            }

            <button type="button" class="btn custom-pill-btn filter-btn btn-light active" data-filter="all">
                <i class="bi bi-calendar3 me-1"></i> @upcomingSlots Upcoming Slot@(upcomingSlots != 1 ? "s" : "")
            </button>
            <button type="button" class="btn custom-pill-btn filter-btn btn-success-custom" data-filter="booked">
                <i class="bi bi-check-circle me-1"></i> @bookedSlots Booked
            </button>
            <button type="button" class="btn custom-pill-btn filter-btn btn-dark-custom" data-filter="available">
                <i class="bi bi-calendar-check me-1"></i> @freeSlots Available
            </button>
            <button type="button" class="btn custom-pill-btn filter-btn btn-dark-custom" data-filter="history">
                <i class="bi bi-clock-history me-1"></i> @historySlots History
            </button>
        </div>

        <!-- Make Your Schedule Button -->
        <div>
            <button class="btn custom-pill-btn btn-black-custom" data-bs-toggle="modal" data-bs-target="#addScheduleModal">
                <i class="bi bi-plus-circle me-1"></i> Make Your Schedule
            </button>
        </div>
    </div>

    <!-- Table Container Card -->
    <div class="table-container-card">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <p class="fs-5 mb-3" style="color: #cccccc;">You have no scheduled sessions yet.</p>
                <button class="btn custom-pill-btn btn-black-custom px-4 py-2" data-bs-toggle="modal" data-bs-target="#addScheduleModal">
                    Create Your First Schedule
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table custom-dark-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 15%;">Date</th>
                            <th style="width: 12%;">Start Time</th>
                            <th style="width: 12%;">End Time</th>
                            <th style="width: 21%;">Notes</th>
                            <th style="width: 12%;" class="text-center">Status</th>
                            <th style="width: 18%;">Booked By</th>
                            <th style="width: 10%;" class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            bool isPast = s.ScheduleDate.Add(s.EndTime) < DateTime.Now;
                            string filterCategory = isPast ? "history" : (s.IsBooked ? "booked" : "available");

                            <tr class="schedule-row" data-filter="@filterCategory">
                                <td class="fw-medium">@s.ScheduleDate.ToString("MMMM dd, yyyy")</td>
                                <td>@DateTime.Today.Add(s.StartTime).ToString("hh:mm tt")</td>
                                <td>@DateTime.Today.Add(s.EndTime).ToString("hh:mm tt")</td>
                                <td>@(string.IsNullOrEmpty(s.Notes) ? "—" : s.Notes)</td>
                                <td class="text-center">
                                    @if (isPast)
                                    {
                                        <span class="badge text-bg-dark rounded-pill px-3 py-2">
                                            <i class="bi bi-clock-history me-1"></i> @(s.IsBooked ? "Completed" : "Expired")
                                        </span>
                                    }
                                    else if (s.IsBooked)
                                    {
                                        <span class="badge text-bg-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle me-1"></i> Booked
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary rounded-pill px-3 py-2">
                                            <i class="bi bi-calendar me-1"></i> Available
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (s.IsBooked && !string.IsNullOrEmpty(s.BookedByName))
                                    {
                                        <div>
                                            <i class="bi bi-person-check text-success me-1"></i>
                                            @s.BookedByName
                                        </div>
                                        @if (s.BookedAt.HasValue)
                                        {
                                            <small style="color: #888888; font-size: 0.8rem;">
                                                @s.BookedAt.Value.ToString("MMM dd, yyyy hh:mm tt")
                                            </small>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color: #777777;">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (!s.IsBooked && !isPast)
                                    {
                                        <form asp-action="DeleteSchedule" method="post"
                                              onsubmit="return confirm('Remove this schedule slot?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                                <i class="bi bi-trash me-1"></i> Remove
                                            </button>
                                        </form>
                                    }
                                    else if (isPast)
                                    {
                                        <span class="small" style="color: #777777;" title="This slot has already passed">
                                            <i class="bi bi-clock-history"></i> Past
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="small" style="color: #777777;" title="Cannot remove a booked slot">
                                            <i class="bi bi-lock"></i> Locked
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                        <tr id="noResultsRow" style="display:none;">
                            <td colspan="7" class="text-center py-5" style="color: #999999;">
                                No schedules match this filter.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* Add Schedule Modal *@
<div class="modal fade" id="addScheduleModal" tabindex="-1" aria-labelledby="addScheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #242424; color: #ffffff; border: 1px solid #3d3d3d;">
            <div class="modal-header" style="border-bottom: 1px solid #3d3d3d;">
                <h5 class="modal-title fw-bold" id="addScheduleModalLabel">Make Your Schedule</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddSchedule" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-light">Date</label>
                        <input type="date" name="scheduleDate" id="scheduleDate" class="form-control custom-dark-input"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-light">Start Time</label>
                        <input type="time" name="startTime" id="startTime" class="form-control custom-dark-input"
                               min="08:00" max="23:59" required />
                        <div class="form-text" style="color: #a0a0a0;">Sessions can start between 8:00 AM and 11:59 PM.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-light">Duration</label>
                        <select name="durationMinutes" id="durationMinutes" class="form-select custom-dark-input" required>
                            <option value="" disabled selected>Select duration</option>
                            <option value="60">1 hour</option>
                            <option value="90">1 hour 30 minutes</option>
                            <option value="120">2 hours</option>
                            <option value="150">2 hours 30 minutes</option>
                            <option value="180">3 hours</option>
                            <option value="210">3 hours 30 minutes</option>
                            <option value="240">4 hours</option>
                        </select>
                        <div class="form-text" style="color: #a0a0a0;">Minimum 1 hour, in 30-minute increments.</div>
                    </div>

                    @* Hidden end time *@
                    <input type="hidden" name="endTime" id="endTime" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-light">End Time <span class="fw-normal" style="color: #a0a0a0;">(auto-calculated)</span></label>
                        <input type="text" id="endTimeDisplay" class="form-control custom-dark-input" readonly
                               placeholder="Select start time and duration" style="background-color: #1a1a1a;" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-light">Notes <span class="fw-normal" style="color: #a0a0a0;">(optional)</span></label>
                        <input type="text" name="notes" class="form-control custom-dark-input"
                               placeholder="e.g. Strength Training, Cardio Session..." />
                    </div>

                </div>
                <div class="modal-footer" style="border-top: 1px solid #3d3d3d;">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Apply</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // Existing slots for THIS trainer, sent from the server so JS can check conflicts live
        const existingSchedules = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Select(s => new {
                date = s.ScheduleDate.ToString("yyyy-MM-dd"),
                startMinutes = s.StartTime.Hours * 60 + s.StartTime.Minutes,
                endMinutes = s.EndTime.Hours * 60 + s.EndTime.Minutes
            })
        ));

        function formatMinutes(totalMinutes) {
            const h = Math.floor(totalMinutes / 60) % 24;
            const m = totalMinutes % 60;
            const period = h >= 12 ? 'PM' : 'AM';
            const displayH = h % 12 || 12;
            return String(displayH).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ' ' + period;
        }

        function updateEndTime() {
            const startInput = document.getElementById('startTime');
            const dateInput = document.getElementById('scheduleDate');
            const startVal = startInput.value;
            const dateVal = dateInput.value;
            const durationVal = document.getElementById('durationMinutes').value;

            startInput.setCustomValidity('');

            if (!startVal || !durationVal) {
                document.getElementById('endTime').value = '';
                document.getElementById('endTimeDisplay').value = '';
                return;
            }

            const [hours, minutes] = startVal.split(':').map(Number);
            const startTotalMinutes = hours * 60 + minutes;

            if (startTotalMinutes < 8 * 60) {
                startInput.setCustomValidity('Value must be 8:00 AM or later.');
                startInput.reportValidity();
                document.getElementById('endTime').value = '';
                document.getElementById('endTimeDisplay').value = '';
                return;
            }

            const rawEndTotalMinutes = startTotalMinutes + parseInt(durationVal);

            if (rawEndTotalMinutes >= 24 * 60) {
                startInput.setCustomValidity(
                    'This session would cross into the next day. Choose an earlier start time or a shorter duration.'
                );
                startInput.reportValidity();
                document.getElementById('endTime').value = '';
                document.getElementById('endTimeDisplay').value = '';
                return;
            }

            if (dateVal) {
                const conflict = existingSchedules.find(function (s) {
                    return s.date === dateVal &&
                        startTotalMinutes < s.endMinutes &&
                        rawEndTotalMinutes > s.startMinutes;
                });

                if (conflict) {
                    startInput.setCustomValidity(
                        'This overlaps an existing schedule from ' +
                        formatMinutes(conflict.startMinutes) + ' to ' +
                        formatMinutes(conflict.endMinutes) + '. Choose a different time.'
                    );
                    startInput.reportValidity();
                    document.getElementById('endTime').value = '';
                    document.getElementById('endTimeDisplay').value = '';
                    return;
                }
            }

            const endHours = Math.floor(rawEndTotalMinutes / 60) % 24;
            const endMins = rawEndTotalMinutes % 60;

            const endTimeStr = String(endHours).padStart(2, '0') + ':' + String(endMins).padStart(2, '0');
            document.getElementById('endTime').value = endTimeStr;

            document.getElementById('endTimeDisplay').value = formatMinutes(rawEndTotalMinutes);
        }

        document.getElementById('startTime').addEventListener('input', updateEndTime);
        document.getElementById('startTime').addEventListener('change', updateEndTime);
        document.getElementById('durationMinutes').addEventListener('change', updateEndTime);
        document.getElementById('scheduleDate').addEventListener('change', updateEndTime);

        document.querySelector('#addScheduleModal form').addEventListener('submit', function (e) {
            const startInput = document.getElementById('startTime');
            if (!document.getElementById('endTime').value) {
                e.preventDefault();
                startInput.reportValidity();
            }
        });

        // Badge filter logic: All / Booked / Available / History
        (function () {
            const filterButtons = document.querySelectorAll('.filter-btn');
            const rows = document.querySelectorAll('.schedule-row');
            const noResultsRow = document.getElementById('noResultsRow');

            function applyFilter(filter) {
                let visibleCount = 0;
                rows.forEach(row => {
                    const match = filter === 'all'
                        ? row.dataset.filter !== 'history'
                        : row.dataset.filter === filter;
                    row.style.display = match ? '' : 'none';
                    if (match) visibleCount++;
                });
                if (noResultsRow) {
                    noResultsRow.style.display = visibleCount === 0 ? '' : 'none';
                }
            }

            filterButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    filterButtons.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    applyFilter(this.dataset.filter);
                });
            });

            applyFilter('all');
        })();
    </script>
}
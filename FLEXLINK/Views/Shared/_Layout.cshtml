<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FLEXLINK</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Membership.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FLEXLINK.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/SideBar.css" />
</head>
<body>

    @if (User.Identity.IsAuthenticated)
    {
        /* Dynamic Route Matching Variables */
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        <!-- LOGGED IN USER: SIDEBAR LAYOUT -->
        <div class="app-container">
            <aside class="sidebar">
                <div class="sidebar-top">
                    <a class="sidebar-brand-container text-decoration-none mb-5 d-block text-center" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo_f.png" alt="FLEXLINK" class="sidebar-logo img-fluid" />
                    </a>

                    <ul class="nav flex-column mb-auto">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Admin" && currentAction == "Index" ? "active" : "")" asp-controller="Admin" asp-action="Index"><i class="bi bi-grid-fill"></i><span>Dashboard</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Admin" && currentAction == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people-fill"></i><span>User</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Admin" && currentAction == "Trainers" ? "active" : "")" asp-controller="Admin" asp-action="Trainers"><i class="bi bi-person-badge"></i><span>Trainer</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Admin" && currentAction == "Equipment" ? "active" : "")" asp-controller="Admin" asp-action="Equipment"><i class="bi bi-wrench"></i><span>Equipment</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Admin" && currentAction == "Income" ? "active" : "")" asp-controller="Admin" asp-action="Income"><i class="bi bi-cash-stack"></i><span>Income</span></a>
                            </li>
                        }
                        else if (User.IsInRole("Trainer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Trainer" && currentAction == "Index" ? "active" : "")" asp-controller="Trainer" asp-action="Index"><i class="bi bi-grid-fill"></i><span>Dashboard</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Trainer" && currentAction == "EditProfile" ? "active" : "")" asp-controller="Trainer" asp-action="EditProfile"><i class="bi bi-person-fill"></i><span>Profile</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Trainer" && currentAction == "MySchedule" ? "active" : "")" asp-controller="Trainer" asp-action="MySchedule"><i class="bi bi-calendar4-week"></i><span>Schedule</span></a>
                            </li>
                        }
                        else if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Staff" && currentAction == "Index" ? "active" : "")" asp-controller="Staff" asp-action="Index"><i class="bi bi-grid-fill"></i><span>Dashboard</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Staff" && currentAction == "SpaceCapacity" ? "active" : "")" asp-controller="Staff" asp-action="SpaceCapacity"><i class="bi bi-check-square"></i><span>Registration Approval</span></a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-fill"></i><span>Dashboard</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" && currentAction == "UserProfile" ? "active" : "")" asp-controller="Home" asp-action="UserProfile"><i class="bi bi-person-fill"></i><span>Profile</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" && currentAction == "Schedule" ? "active" : "")" asp-controller="Home" asp-action="Schedule"><i class="bi bi-calendar4-week"></i><span>Schedule</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" && currentAction == "Trainer" ? "active" : "")" asp-controller="Home" asp-action="Trainer"><i class="bi bi-person-badge"></i><span>Trainer</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" && currentAction == "Membership" ? "active" : "")" asp-controller="Home" asp-action="Membership"><i class="bi bi-card-heading"></i><span>Membership</span></a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="sidebar-bottom">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sidebar-logout text-start">
                            <i class="bi bi-box-arrow-right"></i><span>Signout</span>
                        </button>
                    </form>
                </div>
            </aside>

            <div class="main-content">
                <div class="page-body">
                    @RenderBody()
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- GUEST / LANDING PAGE SPLIT DESIGN -->
        <div class="container-fluid p-0 flexlink-guest-wrapper overflow-hidden">
            <div class="row g-0 min-vh-100">

                <!-- LEFT SECTION (Dark Hero Content) -->
                <div class="col-lg-7 d-flex flex-column justify-content-between p-4 p-md-5">

                    <!-- Header Navigation -->
                    <header>
                        <nav class="navbar navbar-expand-lg navbar-dark bg-transparent p-0 guest-nav">
                            <div class="container-fluid p-0">
                                <a class="navbar-brand me-4" asp-area="" asp-controller="Home" asp-action="Index">
                                    <img src="~/images/logo_f.png" alt="FLEXLINK" class="guest-nav-logo img-fluid" style="max-height: 90px; width: auto;" />
                                </a>
                                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#guestNavbar">
                                    <span class="navbar-toggler-icon"></span>
                                </button>

                                <div class="collapse navbar-collapse" id="guestNavbar">
                                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                                        <li class="nav-item">
                                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">HOME</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">ABOUT</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Programs">PROGRAMS</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Trainer">TRAINERS</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Membership">PRICING</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Schedule">SCHEDULE</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </nav>
                    </header>

                    <!-- Hero Main Section -->
                    <div class="my-auto py-5 px-md-4">
                        <h1 class="hero-title-solid text-white text-uppercase mb-0">FORGE YOUR</h1>
                        <h1 class="hero-title-outline text-uppercase mb-4">B O D Y</h1>

                        <p class="hero-description mb-4">
                            Transform your physique with science-backed training programs, expert coaches, and state-of-the-art facilities
                        </p>

                        <a asp-controller="Account" asp-action="Register" class="btn btn-join-now text-uppercase mb-5">
                            JOIN NOW !
                        </a>

                        <div class="w-100 mb-4">
                            @RenderBody()
                        </div>

                        <div class="row pt-2 text-start" style="max-width: 440px;">
                            <div class="col-4">
                                <div class="stat-number">12K+</div>
                                <div class="stat-label text-uppercase">ACTIVE MEMBERS</div>
                            </div>
                            <div class="col-4">
                                <div class="stat-number">80%</div>
                                <div class="stat-label text-uppercase">SUCCESS RATE</div>
                            </div>
                            <div class="col-4">
                                <div class="stat-number">48+</div>
                                <div class="stat-label text-uppercase">ELITE MEMBERS</div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer Info -->
                    <div class="px-md-4 text-muted small">
                        &copy; @DateTime.Now.Year - FLEXLINK. All rights reserved.
                    </div>
                </div>

                <!-- RIGHT SECTION (Red Branding Panel) -->
                <div class="col-lg-5 red-banner-section d-none d-lg-flex flex-column align-items-center justify-content-between p-4 p-md-5">

                    <!-- Top Navigation for Auth Links on Red Side -->
                    <div class="w-100 d-flex justify-content-end red-side-auth">
                        <partial name="_LoginPartial" />
                    </div>

                    <!-- Centered Branding Logo & Subtext -->
                    <div class="my-auto text-center">
                        <img src="~/images/logo_f.png" alt="FLEXLINK" class="red-banner-logo img-fluid mb-2" />
                    </div>

                    <!-- Spacer to balance vertical alignment -->
                    <div></div>
                </div>

            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@using FLEXLINK.Models
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";


}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Admin Dashboard</h2>
            <p class="text-muted mb-0">Manage all users, trainers, and gym equipment.</p>
        </div>
        <a asp-controller="Admin" asp-action="CreateTrainer" class="btn btn-success">
            <i class="bi bi-person-plus me-1"></i> Create Trainer Account
        </a>
    </div>

    @* Alerts *@
    @if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-1"></i> @TempData["AdminSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle me-1"></i> @TempData["AdminError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ── SPACE CAPACITY ── *@
    @{
        int currentCount = ViewBag.CurrentCount;
        int maxCapacity = ViewBag.MaxCapacity;
        bool isFull = currentCount >= maxCapacity;
        double percent = maxCapacity > 0 ? Math.Round((double)currentCount / maxCapacity * 100, 0) : 0;
    }
    <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-semibold"><i class="bi bi-people-fill me-1"></i>Space Capacity (Today)</span>
                <span class="fw-bold @(isFull ? "text-danger" : "text-success")">
                    @currentCount / @maxCapacity
                </span>
            </div>
            <div class="progress" style="height: 18px; border-radius: 10px;">
                <div class="progress-bar @(isFull ? "bg-danger" : "bg-success")"
                     role="progressbar"
                     style="width: @percent%;"
                     aria-valuenow="@currentCount" aria-valuemin="0" aria-valuemax="@maxCapacity">
                </div>
            </div>
            @if (isFull)
            {
                <p class="text-danger small mt-2 mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    Gym is at full capacity. Staff cannot check in any more members or guests.
                </p>
            }
        </div>
    </div>

@* ── TRAINERS, USERS & EQUIPMENT SUMMARY ── *@
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-start border-4 border-primary shadow-sm h-100" style="border-radius:12px;">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-primary mb-1">
                            <i class="bi bi-person-badge me-1"></i>@ViewBag.TrainerCount Total
                        </span>
                        <div class="fw-semibold">Trainers</div>
                    </div>
                    <a asp-controller="Admin" asp-action="Trainers" class="btn btn-outline-primary btn-sm">
                        View Trainers <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-start border-4 border-secondary shadow-sm h-100" style="border-radius:12px;">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-secondary mb-1">
                            <i class="bi bi-people me-1"></i>@ViewBag.UserCount Total
                        </span>
                        <div class="fw-semibold">Users</div>
                    </div>
                    <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-secondary btn-sm">
                        View Users <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-start border-4 border-warning shadow-sm h-100" style="border-radius:12px;">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-warning text-dark mb-1">
                            <i class="bi bi-tools me-1"></i>@ViewBag.EquipmentCount Total
                        </span>
                        <div class="fw-semibold">
                            Equipment
                            @if ((int)ViewBag.PendingRepairCount > 0)
                            {
                                <span class="badge bg-danger ms-1">@ViewBag.PendingRepairCount pending</span>
                            }
                        </div>
                    </div>
                    <a asp-controller="Admin" asp-action="Equipment" class="btn btn-outline-warning btn-sm">
                        View Equipment <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

@* ── INCOME REPORTS ── *@
@{
    var monthlyIncome = ViewBag.MonthlyIncome as List<FLEXLINK.ViewModels.MonthlyIncomeViewModel> ?? new();
}
    <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
        <div class="card-body d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-cash-stack me-1"></i>All-Time Income</span>
            <span class="fw-bold text-success fs-4">₱@(((decimal)ViewBag.TotalIncome).ToString("N0"))</span>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center"
             style="border-radius:12px 12px 0 0;">
            <span class="fw-bold fs-6">
                <i class="bi bi-graph-up me-2"></i>Monthly Income Breakdown
            </span>
            <span class="badge bg-white text-success">@monthlyIncome.Count month@(monthlyIncome.Count != 1 ? "s" : "")</span>
        </div>
        <div class="card-body p-0">
            @if (!monthlyIncome.Any())
            {
                <p class="text-muted text-center py-4 mb-0">
                    <i class="bi bi-inbox me-1"></i>No approved memberships yet.
                </p>
            }
            else
            {
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Month</th>
                            <th class="text-center">Memberships Sold</th>
                            <th class="text-end">Income</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowIndex = 0;
                        }
                        @foreach (var row in monthlyIncome)
                        {
                            rowIndex++;
                            string collapseId = $"monthDetail{rowIndex}";
                            <tr style="cursor:pointer;" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                <td>
                                    <i class="bi bi-chevron-right me-2 text-muted"></i>
                                    <i class="bi bi-calendar3 me-2 text-success"></i>@row.MonthLabel
                                </td>
                                <td class="text-center">
                                    @row.MembershipCount
                                    <div class="mt-1">
                                        @if (row.OneMonthCount > 0)
                                        {
                                            <span class="badge bg-light text-dark border me-1">1mo × @row.OneMonthCount</span>
                                        }
                                        @if (row.TwoMonthCount > 0)
                                        {
                                            <span class="badge bg-light text-dark border me-1">2mo × @row.TwoMonthCount</span>
                                        }
                                        @if (row.ThreeMonthCount > 0)
                                        {
                                            <span class="badge bg-light text-dark border">3mo × @row.ThreeMonthCount</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end fw-semibold">₱@row.Total.ToString("N0")</td>
                            </tr>
                            <tr class="collapse" id="@collapseId">
                                <td colspan="3" class="bg-light p-0">
                                    <table class="table table-sm mb-0">
                                        <thead>
                                            <tr class="small text-muted">
                                                <th class="ps-4">Member</th>
                                                <th>Plan</th>
                                                <th>Start Date</th>
                                                <th>Expiry Date</th>
                                                <th class="text-end pe-4">Price</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var detail in row.Details)
                                            {
                                                <tr>
                                                    <td class="ps-4">@detail.UserName</td>
                                                    <td>@detail.PlanLabel</td>
                                                    <td>@detail.StartDate.ToString("MMM dd, yyyy")</td>
                                                    <td>@detail.ExpiryDate.ToString("MMM dd, yyyy")</td>
                                                    <td class="text-end pe-4">₱@detail.Price.ToString("N0")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>


    



@* ── Delete User Confirmation Modal ── *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete the account for
                <strong id="deleteUserEmail"></strong>?
                <br />
                <span class="text-danger small">This action cannot be undone. All their data will be removed.</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-controller="Admin" asp-action="DeleteUser" method="post" id="deleteForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" id="deleteUserId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Yes, Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('deleteUserId').value = button.getAttribute('data-user-id');
            document.getElementById('deleteUserEmail').textContent = button.getAttribute('data-user-email');
        });
    </script>
}

@model IEnumerable<FLEXLINK.Models.Users>

@{
    ViewData["Title"] = "Users";
}

<div class="container mt-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Users Management</h2>
            <p class="text-muted mb-0">Manage registered gym members and client accounts.</p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["AdminSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["AdminError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Users Card Table (Original Dashboard Dark Gray Card) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center py-2 px-3">
            <div class="fw-bold">
                <i class="bi bi-people-fill me-2"></i> Users
            </div>
            <span class="badge bg-white text-dark rounded-pill fw-bold">@Model.Count()</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    No users registered yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-3">Full Name</th>
                                <th>Email</th>
                                <th>Username</th>
                                <th>Date Created</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">
                                        <i class="bi bi-person-circle me-2 text-secondary"></i>@user.FullName
                                    </td>
                                    <td class="text-primary">@user.Email</td>
                                    <td>@user.UserName</td>
                                    <td class="text-muted small">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-outline-secondary btn-sm px-3"
                                                    onclick="showUserProfile('@user.FullName', '@user.Email', '@user.PhoneNumber', '@user.Address', '@user.Age', '@(string.IsNullOrEmpty(user.ProfilePicture) ? "/uploads/DefaultProfile.png" : user.ProfilePicture)', '@user.CreatedAt.ToString("MMM dd, yyyy")')">
                                                <i class="bi bi-eye-fill me-1"></i> View
                                            </button>
                                            <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm px-3">
                                                    <i class="bi bi-trash-fill me-1"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ── User Profile View Modal ── *@
    <div class="modal fade" id="userProfileModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:16px; overflow:hidden;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="userProfileName"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center pt-2 pb-4">
                    <img id="userProfileImage" src="" alt="Profile Picture"
                         style="width:140px; height:140px; object-fit:cover; border-radius:50%; margin-bottom:16px;" />
                    <div class="text-start">
                        <p class="mb-2"><i class="bi bi-envelope-fill me-2 text-secondary"></i><strong>Email:</strong> <span id="userProfileEmail"></span></p>
                        <p class="mb-2"><i class="bi bi-telephone-fill me-2 text-secondary"></i><strong>Phone:</strong> <span id="userProfilePhone"></span></p>
                        <p class="mb-2"><i class="bi bi-geo-alt-fill me-2 text-secondary"></i><strong>Address:</strong> <span id="userProfileAddress"></span></p>
                        <p class="mb-2"><i class="bi bi-person-fill me-2 text-secondary"></i><strong>Age:</strong> <span id="userProfileAge"></span></p>
                        <p class="mb-0"><i class="bi bi-calendar-check-fill me-2 text-secondary"></i><strong>Joined:</strong> <span id="userProfileCreated"></span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            function showUserProfile(name, email, phone, address, age, pic, created) {
                document.getElementById('userProfileName').textContent = name;
                document.getElementById('userProfileEmail').textContent = email || '—';
                document.getElementById('userProfilePhone').textContent = phone || '—';
                document.getElementById('userProfileAddress').textContent = address || '—';
                document.getElementById('userProfileAge').textContent = age || '—';
                document.getElementById('userProfileCreated').textContent = created;
                document.getElementById('userProfileImage').src = pic;

                var modal = new bootstrap.Modal(document.getElementById('userProfileModal'));
                modal.show();
            }
        </script>
    }

</div>
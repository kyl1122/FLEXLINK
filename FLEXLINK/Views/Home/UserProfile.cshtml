@model FLEXLINK.Models.Users
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4" style="max-width: 620px;">

    <div class="mb-4 text-center">
        <h2 class="fw-bold">My Profile</h2>
        <p class="text-muted">View your account details and update your information.</p>
    </div>

    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-1"></i> @TempData["ProfileSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ProfileError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle me-1"></i> @TempData["ProfileError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-controller="Home" asp-action="UpdateUserProfile"
          method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">

            <div class="p-4 text-center"
                 style="background: linear-gradient(135deg, #0d6efd, #6610f2);">
                <img src="@(string.IsNullOrEmpty(Model.ProfilePicture) ? "/uploads/DefaultProfile.png" : Model.ProfilePicture)"
                     alt="Profile Picture"
                     id="profilePreview"
                     style="width:110px; height:110px; border-radius:50%; object-fit:cover; border:4px solid white;" />
                <h5 class="fw-bold text-white mt-3 mb-0">@(Model.FullName ?? "—")</h5>
                <p class="mb-0" style="color:rgba(255,255,255,0.7); font-size:0.85rem;">@Model.Email</p>
            </div>

            <div class="card-body p-4">

                <h6 class="fw-bold text-muted text-uppercase small mb-3">
                    <i class="bi bi-info-circle me-1"></i> Account Information
                </h6>

                <div class="row g-3 mb-1">
                    <div class="col-6">
                        <p class="text-muted small mb-1">Email</p>
                        <p class="fw-semibold mb-0">@(Model.Email ?? "—")</p>
                    </div>
                    <div class="col-6">
                        <p class="text-muted small mb-1">Member Since</p>
                        <p class="fw-semibold mb-0">@Model.CreatedAt.ToString("MMMM dd, yyyy")</p>
                    </div>
                </div>

                <hr />

                <h6 class="fw-bold text-muted text-uppercase small mb-3">
                    <i class="bi bi-pencil me-1"></i> Edit Information
                </h6>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Full Name</label>
                    <input type="text" name="FullName" class="form-control"
                           value="@(Model.FullName ?? "")"
                           placeholder="Enter your full name" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Phone Number</label>
                    <input type="text" name="PhoneNumber" class="form-control"
                           value="@(Model.PhoneNumber ?? "")"
                           placeholder="Enter your phone number" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Address</label>
                    <input type="text" name="Address" class="form-control"
                           value="@(Model.Address ?? "")"
                           placeholder="Enter your address" />
                </div>

                <hr />

                <h6 class="fw-bold text-muted text-uppercase small mb-3">
                    <i class="bi bi-camera me-1"></i> Update Profile Picture
                </h6>

                <div class="mb-3">
                    <input type="file" name="ProfileImage" class="form-control"
                           accept=".jpg,.jpeg,.png" id="profileImageInput" />
                    <div class="form-text">Max 2MB. Accepted formats: JPG, JPEG, PNG.</div>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-save me-1"></i> Save Changes
                </button>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('profileImageInput').addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('profilePreview').src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}   
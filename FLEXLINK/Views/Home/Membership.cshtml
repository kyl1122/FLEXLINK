@using FLEXLINK.Models
@{
    ViewData["Title"] = "Membership Plans";
    var activeMembership = ViewBag.ActiveMembership as UserMembership;
}
<head>
    <link rel="stylesheet" href="~/css/User_MemberShip.css" />
</head>

<div class="container py-5">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <h2 class="section-title text-white mb-2">CHOOSE YOUR PLAN</h2>
        <p class="section-subtitle text-secondary">SELECT THE MEMBERSHIP THAT FITS YOUR FITNESS GOALS</p>
    </div>

    @* Alerts *@
    @if (TempData["MembershipSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show text-center bg-dark text-success border-success mb-4">
            <i class="bi bi-check-circle me-1"></i> @TempData["MembershipSuccess"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["MembershipError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show text-center bg-dark text-danger border-danger mb-4">
            <i class="bi bi-exclamation-circle me-1"></i> @TempData["MembershipError"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Active Membership Banner *@
    @if (activeMembership != null)
    {
        <div class="active-banner-dark p-3 mb-4 d-flex align-items-center gap-3">
            <i class="bi bi-patch-check-fill text-success fs-3"></i>
            <div>
                <strong class="text-success text-uppercase">You have an active membership!</strong>
                <p class="mb-0 small text-secondary">
                    @activeMembership.Months-month plan &nbsp;·&nbsp;
                    Valid until <strong class="text-white">@activeMembership.ExpiryDate.ToString("MMMM dd, yyyy")</strong>
                </p>
            </div>
        </div>
    }

    <div class="row row-cols-1 row-cols-md-3 g-4 align-items-stretch">

        @* 1 Month *@
        <div class="col">
            <div class="card membership-card-dark">
                <div class="card-header-dark text-center">
                    <h4 class="plan-title text-white">1 Month</h4>
                </div>
                <div class="card-body text-center d-flex flex-column justify-content-between p-4">
                    <div>
                        <h1 class="price-text">₱300</h1>
                        <p class="text-secondary small">Basic access for one month.</p>
                    </div>
                    <button type="button" class="btn btn-outline-custom w-100 mt-3"
                            data-bs-toggle="modal" data-bs-target="#confirmPlan1">
                        Get Started
                    </button>
                </div>
            </div>
        </div>

        @* 2 Months (Featured) *@
        <div class="col">
            <div class="card membership-card-dark featured-card">
                <div class="card-header-dark featured-header text-center">
                    <h4 class="plan-title">2 Months</h4>
                </div>
                <div class="card-body text-center d-flex flex-column justify-content-between p-4">
                    <div>
                        <h1 class="price-text">₱550</h1>
                        <p class="text-secondary small">Best value for regular members.</p>
                    </div>
                    <button type="button" class="btn btn-fill-custom w-100 mt-3"
                            data-bs-toggle="modal" data-bs-target="#confirmPlan2">
                        Most Popular
                    </button>
                </div>
            </div>
        </div>

        @* 3 Months *@
        <div class="col">
            <div class="card membership-card-dark">
                <div class="card-header-dark text-center">
                    <h4 class="plan-title text-white">3 Months</h4>
                </div>
                <div class="card-body text-center d-flex flex-column justify-content-between p-4">
                    <div>
                        <h1 class="price-text">₱800</h1>
                        <p class="text-secondary small">Maximum savings for committed athletes.</p>
                    </div>
                    <button type="button" class="btn btn-outline-custom w-100 mt-3"
                            data-bs-toggle="modal" data-bs-target="#confirmPlan3">
                        Go Elite
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

@* ── Confirm Modals ── *@
@foreach (var plan in new[] {
    new { Id = "confirmPlan1", Months = 1, Price = "₱300", Label = "1 Month Plan" },
    new { Id = "confirmPlan2", Months = 2, Price = "₱550", Label = "2 Months Plan" },
    new { Id = "confirmPlan3", Months = 3, Price = "₱800", Label = "3 Months Plan" }
})
{
    <div class="modal fade" id="@plan.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content custom-modal-dark">
                <div class="modal-header border-bottom-dark">
                    <h5 class="modal-title text-white fw-bold">CONFIRM PURCHASE</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <h5 class="text-white mb-2">You selected the <strong>@plan.Label</strong></h5>
                    <p class="text-secondary mb-2">Price: <strong class="text-white">@plan.Price</strong></p>
                    <p class="text-secondary small mb-0">
                        @if (activeMembership != null)
                        {
                            <span>Your plan will be extended from <strong class="text-white">@activeMembership.ExpiryDate.ToString("MMMM dd, yyyy")</strong>.</span>
                        }
                        else
                        {
                            <span>Your membership starts today.</span>
                        }
                    </p>
                </div>
                <div class="modal-footer border-top-dark d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Subscribe" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="months" value="@plan.Months" />
                        <button type="submit" class="btn btn-fill-custom btn-sm">
                            <i class="bi bi-check2-circle me-1"></i> Confirm & Activate
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
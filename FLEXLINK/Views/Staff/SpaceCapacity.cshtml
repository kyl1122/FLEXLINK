@{
    ViewData["Title"] = "Approvals";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var pendingRequests = ViewBag.PendingRequests as List<FLEXLINK.Models.RegistrationRequest> ?? new();
    var paymentUsers = ViewBag.PaymentUsers as Dictionary<string, FLEXLINK.Models.Users> ?? new();
    var pendingPayments = ViewBag.PendingPayments as List<FLEXLINK.Models.UserMembership> ?? new();
}
<link rel="stylesheet" href="~/css/Staff_Cap.css"/>

<div class="approvals-container">
    <div>
        <h1 class="header-title">Approvals</h1>
        <p class="header-subtitle">Review member registration request</p>
    </div>

    <div class="row g-4">
        @* ── Registration Requests Column ── *@
        <div class="col-12 col-lg-6">
            <div class="approval-card">
                <div class="card-title-custom">
                    <i class="bi bi-bell-fill"></i>
                    <span>Registration Requests</span>
                </div>

                @if (pendingRequests.Any())
                {
                    <div class="d-flex flex-column">
                        @foreach (var req in pendingRequests)
                        {
                            <div class="request-item">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(req.ProfilePicture) ? "/uploads/DefaultProfile.png" : req.ProfilePicture)"
                                         class="user-avatar"
                                         onclick="showProfilePreview('@(string.IsNullOrEmpty(req.ProfilePicture) ? "/uploads/DefaultProfile.png" : req.ProfilePicture)', '@req.FullName')" />
                                    <div>
                                        <p class="user-name">@req.FullName</p>
                                        <p class="user-meta">
                                            @req.Email &nbsp; Requested @req.RequestedAt.ToString("MMM dd, hh:mmtt")
                                        </p>
                                    </div>
                                </div>
                                <div class="action-group">
                                    <form asp-controller="Staff" asp-action="ApproveUser" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="requestId" value="@req.Id" />
                                        <button type="submit" class="btn btn-approve w-100">Approve</button>
                                    </form>
                                    <form asp-controller="Staff" asp-action="RejectUser" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="requestId" value="@req.Id" />
                                        <button type="submit" class="btn btn-reject w-100">Reject</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-center my-4 small">No pending registration requests.</p>
                }
            </div>
        </div>

        @* ── Membership Payment Column ── *@
        <div class="col-12 col-lg-6">
            <div class="approval-card">
                <div class="card-title-custom">
                    <i class="bi bi-credit-card"></i>
                    <span>Membership Payment Request</span>
                </div>

                @if (pendingPayments.Any())
                {
                    <div class="d-flex flex-column">
                        @foreach (var pay in pendingPayments)
                        {
                            var hasUser = paymentUsers.TryGetValue(pay.UserId, out var payUser);
                            var payPic = (hasUser && !string.IsNullOrEmpty(payUser!.ProfilePicture)) ? payUser.ProfilePicture : "/uploads/DefaultProfile.png";
                            var payName = hasUser ? (payUser!.FullName ?? payUser.Email) : "Unknown user";

                            <div class="request-item">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@payPic"
                                         class="user-avatar"
                                         onclick="showProfilePreview('@payPic', '@payName')" />
                                    <div>
                                        <p class="user-name">@payName</p>
                                        <p class="user-meta">
                                            @(hasUser? payUser!.Email : "") Requested @pay.StartDate.ToString("MMM dd, hh:mmtt")
                                        </p>
                                    </div>
                                </div>
                                <div class="action-group">
                                    <form asp-controller="Staff" asp-action="ApprovePayment" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="paymentId" value="@pay.Id" />
                                        <button type="submit" class="btn btn-approve w-100">Approve</button>
                                    </form>
                                    <form asp-controller="Staff" asp-action="RejectPayment" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="paymentId" value="@pay.Id" />
                                        <button type="submit" class="btn btn-reject w-100">Reject</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-center my-4 small">No pending payment requests.</p>
                }
            </div>
        </div>
    </div>
</div>

@* ── Profile Picture Preview Modal ── *@
<div class="modal fade" id="profilePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white" style="border-radius:16px;">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold" id="profilePreviewName"></h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pt-2 pb-4">
                <img id="profilePreviewImage" src="" alt="Profile Picture"
                     style="width:100%; max-width:320px; aspect-ratio:1/1; object-fit:cover; border-radius:12px;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showProfilePreview(imageUrl, name) {
            document.getElementById('profilePreviewImage').src = imageUrl;
            document.getElementById('profilePreviewName').textContent = name;
            var modal = new bootstrap.Modal(document.getElementById('profilePreviewModal'));
            modal.show();
        }
    </script>
}
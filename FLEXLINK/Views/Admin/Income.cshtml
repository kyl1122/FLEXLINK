@model List<FLEXLINK.ViewModels.MonthlyIncomeViewModel>
@{
    ViewData["Title"] = "Income Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-0">Income Reports</h2>
        <p class="text-muted mb-0">Monthly income from approved membership purchases.</p>
    </div>
    <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
        <div class="card-body d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-cash-stack me-1"></i>All-Time Income</span>
            <span class="fw-bold text-success fs-4">₱@ViewBag.TotalIncome.ToString("N0")</span>
        </div>
    </div>
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center"
             style="border-radius:12px 12px 0 0;">
            <span class="fw-bold fs-6">
                <i class="bi bi-graph-up me-2"></i>Monthly Breakdown
            </span>
            <span class="badge bg-white text-success">@Model.Count month@(Model.Count != 1 ? "s" : "")</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <p class="text-muted text-center py-4 mb-0">
                    <i class="bi bi-inbox me-1"></i>No approved memberships yet.
                </p>
            }
            else
            {
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Month</th>
                            <th class="text-center">Memberships Sold</th>
                            <th class="text-end">Income</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowIndex = 0;
                        }
                        @foreach (var row in Model)
                        {
                            rowIndex++;
                            string collapseId = $"incomeDetail{rowIndex}";
                            <tr style="cursor:pointer;" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                <td>
                                    <i class="bi bi-chevron-right me-2 text-muted"></i>
                                    <i class="bi bi-calendar3 me-2 text-success"></i>@row.MonthLabel
                                </td>
                                <td class="text-center">
                                    @row.MembershipCount
                                    <div class="mt-1">
                                        @if (row.OneMonthCount > 0)
                                        {
                                            <span class="badge bg-light text-dark border me-1">1mo × @row.OneMonthCount</span>
                                        }
                                        @if (row.TwoMonthCount > 0)
                                        {
                                            <span class="badge bg-light text-dark border me-1">2mo × @row.TwoMonthCount</span>
                                        }
                                        @if (row.ThreeMonthCount > 0)
                                        {
                                            <span class="badge bg-light text-dark border">3mo × @row.ThreeMonthCount</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end fw-semibold">₱@row.Total.ToString("N0")</td>
                            </tr>
                            <tr class="collapse" id="@collapseId">
                                <td colspan="3" class="bg-light p-0">
                                    <table class="table table-sm mb-0">
                                        <thead>
                                            <tr class="small text-muted">
                                                <th class="ps-4">Member</th>
                                                <th>Plan</th>
                                                <th>Start Date</th>
                                                <th>Expiry Date</th>
                                                <th class="text-end pe-4">Price</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var detail in row.Details)
                                            {
                                                <tr>
                                                    <td class="ps-4">@detail.UserName</td>
                                                    <td>@detail.PlanLabel</td>
                                                    <td>@detail.StartDate.ToString("MMM dd, yyyy")</td>
                                                    <td>@detail.ExpiryDate.ToString("MMM dd, yyyy")</td>
                                                    <td class="text-end pe-4">₱@detail.Price.ToString("N0")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
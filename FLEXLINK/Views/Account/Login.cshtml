@using FLEXLINK.ViewModels
@model LoginViewModel;
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Account_Login.css" />
</head>

<div class="login-wrapper">
    <!-- Left Dark Panel -->
    <div class="login-card">
        <div class="back-link">
            <a asp-controller="Home" asp-action="Index">
                <i class="bi bi-arrow-left"></i> Go back
            </a>
        </div>

        <div class="login-form-container">
            <h1 class="login-title">Login</h1>

            <form asp-action="login" method="post" id="loginForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label">Username</label>
                    <input asp-for="Email" class="form-control custom-input" autocomplete="off" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control custom-input" id="passwordInput" type="password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-meta">
                    <div class="remember-box">
                        <input asp-for="RememberMe" class="custom-checkbox" id="rememberMe" />
                        <label class="remember-label" for="rememberMe">Remember me?</label>
                    </div>
                    <a asp-controller="Account" asp-action="VerifyEmail" class="forgot-link">
                        Forgot Password?
                    </a>
                </div>

                <button type="submit" class="btn btn-login" id="loginBtn">
                    <span class="btn-text">Log In</span>
                    <span class="btn-spinner"></span>
                </button>

                <p class="register-prompt">
                    Don't have an account?
                    <a asp-controller="Account" asp-action="Register" class="register-link">Register</a>
                </p>
            </form>
        </div>
    </div>

    <!-- Right Red Graphic Side -->
    <div class="login-graphic">
        <img src="~/images/shadow.png" alt="Shadow Overlay" class="shadow-overlay" />

        <div class="logo-container">
            <img src="~/images/logo_f.png" alt="Logo" class="hero-logo" />
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("loginForm");
        const btn = document.getElementById("loginBtn");

        form.addEventListener("submit", function () {
            // Checks ASP.NET jQuery Validation if enabled
            if (window.jQuery && !$(form).valid()) {
                return;
            }
            btn.classList.add("loading");
            btn.disabled = true;
        });
    });
</script>

@if (ViewBag.LockoutSeconds != null)
{
    <script>
        (function () {
            let secondsLeft = @ViewBag.LockoutSeconds;
            const loginBtn = document.getElementById('loginBtn');
            const errorEl = document.querySelector('.text-danger li') || document.querySelector('.text-danger');
            function tick() {
                if (secondsLeft <= 0) {
                    if (loginBtn) {
                        loginBtn.disabled = false;
                        loginBtn.classList.remove("loading");
                    }
                    if (errorEl) errorEl.textContent = "You can now try logging in again.";
                    return;
                }
                if (loginBtn) loginBtn.disabled = true;
                if (errorEl) errorEl.textContent = `Too many failed login attempts. Please try again in ${secondsLeft} seconds.`;
                secondsLeft--;
                setTimeout(tick, 1000);
            }
            tick();
        })();
    </script>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}
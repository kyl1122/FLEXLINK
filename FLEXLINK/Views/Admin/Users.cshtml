@model IEnumerable<FLEXLINK.Models.Users>

@{
    ViewData["Title"] = "Users";
}

<style>
    /* Scope background strictly to main canvas/body — leaves sidebar untouched */
    html, body, main, .main-content, .content-wrapper, #main-content {
        background-color: #2B2929 !important;
    }
</style>

<head>
    <link rel="stylesheet" href="~/css/Admin_User.css" />
</head>

<div class="container-fluid px-4 py-4" style="background-color: #2B2929 !important; width: 100%; min-height: 100vh; margin: 0;">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mock-title mb-1">User Management</h2>
            <p class="mock-subtitle mb-0">Manage all registered gym members and client accounts</p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bg-dark text-success border-success" role="alert">
            @TempData["AdminSuccess"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show bg-dark text-danger border-danger" role="alert">
            @TempData["AdminError"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Users Card Table -->
    <div class="card mock-card mb-4">

        <!-- Search Bar Header -->
        <div class="mock-search-container">
            <div class="input-group">
                <span class="input-group-text mock-search-addon"><i class="bi bi-search"></i></span>
                <input type="text" id="userSearchInput" class="form-control mock-search-input"
                       placeholder="Search by name, email, or username..." onkeyup="filterUsers()" />
            </div>
        </div>

        <!-- Section Label Header -->
        <div class="mock-card-header d-flex justify-content-between align-items-center">
            <div class="text-uppercase">
                USERS
            </div>
            <span class="badge mock-badge">@Model.Count()</span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-secondary">
                    No users registered yet.
                </div>
            }
            else
            {
                <div id="noUserResults" class="text-center py-5 text-secondary" style="display:none;">
                    <i class="bi bi-search me-1"></i> No users match your search.
                </div>
                <div class="table-responsive">
                    <table class="table mock-table align-middle" id="usersTable">
                        <thead>
                            <tr>
                                <th class="ps-3">Full Name</th>
                                <th>Email</th>
                                <th>Username</th>
                                <th>Date Created</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="ps-3 user-name-text">
                                        @user.FullName
                                    </td>
                                    <td class="user-info-text">@user.Email</td>
                                    <td class="user-info-text">@user.UserName</td>
                                    <td class="user-info-text">@user.CreatedAt.ToString("MMMM dd, yyyy")</td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <button type="button" class="btn btn-mock-view btn-sm"
                                                    onclick="showUserProfile('@user.FullName', '@user.Email', '@user.PhoneNumber', '@user.Address', '@user.Age', '@(string.IsNullOrEmpty(user.ProfilePicture) ? "/uploads/DefaultProfile.png" : user.ProfilePicture)', '@user.CreatedAt.ToString("MMM dd, yyyy")')">
                                                <i class="bi bi-eye-fill me-1"></i> View
                                            </button>
                                            <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn btn-mock-delete btn-sm">
                                                    <i class="bi bi-trash-fill me-1"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ── User Profile View Modal ── *@
    <div class="modal fade" id="userProfileModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary" style="border-radius:16px; overflow:hidden;">
                <div class="modal-header border-bottom border-secondary pb-3">
                    <h5 class="modal-title fw-bold" id="userProfileName"></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center pt-3 pb-4">
                    <img id="userProfileImage" src="" alt="Profile Picture"
                         style="width:140px; height:140px; object-fit:cover; border-radius:50%; margin-bottom:16px; border: 2px solid #5a6270;" />
                    <div class="text-start px-3">
                        <p class="mb-2"><i class="bi bi-envelope-fill me-2 text-secondary"></i><strong>Email:</strong> <span id="userProfileEmail"></span></p>
                        <p class="mb-2"><i class="bi bi-telephone-fill me-2 text-secondary"></i><strong>Phone:</strong> <span id="userProfilePhone"></span></p>
                        <p class="mb-2"><i class="bi bi-geo-alt-fill me-2 text-secondary"></i><strong>Address:</strong> <span id="userProfileAddress"></span></p>
                        <p class="mb-2"><i class="bi bi-person-fill me-2 text-secondary"></i><strong>Age:</strong> <span id="userProfileAge"></span></p>
                        <p class="mb-0"><i class="bi bi-calendar-check-fill me-2 text-secondary"></i><strong>Joined:</strong> <span id="userProfileCreated"></span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            @* ── User Profile SEARCH BAR ── *@
            function filterUsers() {
                const query = document.getElementById('userSearchInput').value.toLowerCase();
                const rows = document.querySelectorAll('#usersTable tbody tr');
                let visibleCount = 0;

                rows.forEach(function (row) {
                    const text = row.innerText.toLowerCase();
                    const match = text.includes(query);
                    row.style.display = match ? '' : 'none';
                    if (match) visibleCount++;
                });

                document.getElementById('noUserResults').style.display = visibleCount === 0 ? '' : 'none';
            }

            function showUserProfile(name, email, phone, address, age, pic, created) {
                document.getElementById('userProfileName').textContent = name;
                document.getElementById('userProfileEmail').textContent = email || '—';
                document.getElementById('userProfilePhone').textContent = phone || '—';
                document.getElementById('userProfileAddress').textContent = address || '—';
                document.getElementById('userProfileAge').textContent = age || '—';
                document.getElementById('userProfileCreated').textContent = created;
                document.getElementById('userProfileImage').src = pic;

                var modal = new bootstrap.Modal(document.getElementById('userProfileModal'));
                modal.show();
            }
        </script>
    }

</div>
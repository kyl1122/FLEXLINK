@{
    ViewData["Title"] = "Registration Pending";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card border-0 shadow-sm text-center p-5" style="border-radius: 16px;">
        <div class="mb-3">
            <i class="bi bi-hourglass-split text-warning" style="font-size: 3rem;"></i>
        </div>
        <h4 class="fw-bold mb-2">Awaiting Approval</h4>
        <p class="text-muted mb-4">
            Your registration has been submitted successfully.<br />
            A staff member will review and verify your account shortly.<br />
            You will be able to log in once your account is approved.
        </p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary w-100">
            <i class="bi bi-arrow-left me-1"></i> Back to Login
        </a>
    </div>
</div>

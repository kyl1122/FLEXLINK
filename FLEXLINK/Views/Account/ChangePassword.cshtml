@using FLEXLINK.ViewModels;
@model ChangePasswordViewModel;

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<link rel="stylesheet" href="~/css/Account_ChangePassword.css" />

<div class="split-layout-container">

    <!-- Left Black Panel -->
    <div class="left-form-panel">
        <div class="top-goback-link">
            <a asp-controller="Account" asp-action="VerifyEmail">
                &larr; Go back
            </a>
        </div>

        <div class="form-content-wrapper">
            <h2 class="form-heading">Change Password</h2>

            <form asp-action="ChangePassword" method="post" class="change-password-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="input-group-custom">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="custom-input" readonly />
                </div>

                <div class="input-group-custom">
                    <label asp-for="NewPassword" class="form-label">New Password</label>
                    <input asp-for="NewPassword" type="password" class="custom-input" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="input-group-custom">
                    <label asp-for="ConfirmNewPassword" class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmNewPassword" type="password" class="custom-input" />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-verify">Verify</button>
            </form>
        </div>
    </div>

    <!-- Right Red Graphic Area -->
    <div class="right-brand-panel">
        <img src="@Url.Content("~/images/Shadow.png")"
             alt="Background Shadow"
             class="brand-panel-shadow" />

        <div class="brand-logo-container">
            <img src="@Url.Content("~/images/logo_f.png")"
                 alt="Brand Logo"
                 class="brand-logo-image"
                 onerror="this.style.display='none'; document.getElementById('logo-fallback-svg').style.display='block';" />

            <svg id="logo-fallback-svg" class="white-f-svg" style="display: none;" viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M 70 180 A 105 105 0 1 1 210 100" stroke="#ffffff" stroke-width="11" stroke-linecap="round" />
                <path d="M 120 220 A 105 105 0 0 0 250 170" stroke="#ffffff" stroke-width="11" stroke-linecap="round" />

                <g fill="#ffffff">
                    <polygon points="125,120 160,85 240,85 185,120" />
                    <polygon points="145,150 170,125 210,125 185,150" />
                    <polygon points="270,45 140,175 140,205 75,270 120,200 120,175" />
                    <polygon points="115,130 135,110 135,150" />
                </g>
            </svg>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}
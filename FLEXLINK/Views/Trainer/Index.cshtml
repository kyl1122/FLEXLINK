@using FLEXLINK.Models
@{
    ViewData["Title"] = "Trainer Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var equipment = ViewBag.Equipment as List<Equipment> ?? new List<Equipment>();
}

<head>
    <link rel="stylesheet" href="~/css/Trainer_Index.css" />
</head>

<!-- Top Banner Section -->
<div class="dashboard-header mb-4">
    <div class="container-fluid">
        <h1 class="dashboard-title m-0">Welcome</h1>
        <p class="text-decoration-none mb-2 d-inline-block" style="color: #f8f9fa">Trainer Portal &mdash; Manage clients, update workout programs, and track progress.</p>
    </div>
</div>

<div class="container-fluid px-4">

    @* Alerts *@
    @if (TempData["EquipmentSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle me-2"></i> @TempData["EquipmentSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["EquipmentError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i> @TempData["EquipmentError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Section Header -->
    <h4 class="section-title">Equipment Status</h4>

    @* Equipment Summary Cards *@
    @{
        int reportCount = equipment.Count(e => e.RepairNotes.Any());
    }
    <div class="row g-3 mb-4">
        <!-- Equipment Total Card -->
        <div class="col-md-6">
            <div class="dark-card-header p-3 rounded-3 shadow-sm h-100 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-tools me-2 fs-5 text-warning"></i>
                        <span class="fw-semibold">Gym Equipment</span>
                    </div>
                    <a asp-controller="Trainer" asp-action="Equipment" class="btn btn-sm btn-outline-light rounded-pill px-3">
                        View <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="d-flex align-items-baseline">
                    <span class="display-6 fw-bold text-warning me-2">@equipment.Count</span>
                    <span class="text-warning fw-semibold">Total</span>
                </div>
            </div>
        </div>

        <!-- Repair Reports Card -->
        <div class="col-md-6">
            <div class="dark-card-header p-3 rounded-3 shadow-sm h-100 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle me-2 fs-5 text-danger"></i>
                        <span class="fw-semibold">Repair Reports</span>
                    </div>
                    <a asp-controller="Trainer" asp-action="EquipmentReports" class="btn btn-sm btn-outline-light rounded-pill px-3">
                        View <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="d-flex align-items-baseline">
                    <span class="display-6 fw-bold text-danger me-2">@reportCount</span>
                    <span class="text-danger fw-semibold">Pending</span>
                </div>
            </div>
        </div>
    </div>

</div>


@* ── Repair Note Modal ── *@
<div class="modal fade" id="repairModal" tabindex="-1" aria-labelledby="repairModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title" id="repairModalLabel">
                    <i class="bi bi-wrench me-2"></i>Report Repair Needed
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Trainer" asp-action="AddRepairNote" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="equipmentId" id="repairEquipmentId" />
                <div class="modal-body">
                    <p class="mb-3">
                        Equipment: <strong id="repairEquipmentName" class="text-warning"></strong>
                    </p>
                    <div class="mb-3">
                        <label for="noteInput" class="form-label fw-semibold">Describe the issue</label>
                        <textarea class="form-control" id="noteInput" name="note" rows="3"
                                  placeholder="e.g. Treadmill belt is slipping, needs lubrication..."
                                  required maxlength="1000"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-send me-1"></i>Submit Report
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('repairModal').addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('repairEquipmentId').value = btn.getAttribute('data-equipment-id');
            document.getElementById('repairEquipmentName').textContent = btn.getAttribute('data-equipment-name');
            document.getElementById('noteInput').value = '';
        });
    </script>
}
@model FLEXLINK.Models.Users
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <link rel="stylesheet" href="~/css/StyleSheet1.css" />
</head>

<div class="container-fluid dark-container py-4 px-4">
    <div class="mb-4">
        <h1 class="profile-title mb-1">My Profile</h1>
        <p class="profile-subtitle mb-0">View your account details and update your information.</p>
    </div>

    <div class="top-center-alert-container">
        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show bg-dark text-success border-success shadow-lg" role="alert">
                <i class="bi bi-check-circle me-1"></i> @TempData["ProfileSuccess"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ProfileError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show bg-dark text-danger border-danger shadow-lg" role="alert">
                <i class="bi bi-exclamation-circle me-1"></i> @TempData["ProfileError"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <form asp-controller="Home" asp-action="UpdateUserProfile" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="row align-items-start mt-4">
            <!-- Left Column: Profile Picture & Upload -->
            <div class="col-md-5 text-start pe-md-4">
                <div class="mb-3">
                    <img src="@(string.IsNullOrEmpty(Model.ProfilePicture) ? "/uploads/DefaultProfile.png" : Model.ProfilePicture)"
                         alt="Profile Picture"
                         id="profilePreview"
                         class="img-fluid profile-image" />
                </div>

                <div class="mb-2">
                    <label for="profileImageInput" class="btn btn-upload-outline cursor-pointer">
                        <i class="bi bi-camera me-2"></i>Upload Image
                    </label>
                    <input type="file" name="ProfileImage" class="d-none"
                           accept=".jpg,.jpeg,.png" id="profileImageInput" />
                </div>
                <div class="field-hint mt-2">Max 2MB. Accepted formats: JPG, JPEG, PNG.</div>
            </div>

            <!-- Right Column: Form Inputs & Actions -->
            <div class="col-md-7">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label field-hint mb-1">Email cannot be changed here.</label>
                        <input type="text" class="form-control dark-input"
                               value="@(Model.Email ?? "Ace@gmail.com")" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label field-hint mb-1">Member Since</label>
                        <input type="text" class="form-control dark-input"
                               value="@Model.CreatedAt.ToString("MMMM dd, yyyy")" readonly />
                    </div>

                    <div class="col-12 mt-3">
                        <input type="text" name="FullName" class="form-control dark-input"
                               value="@(Model.FullName ?? "")"
                               placeholder="Full Name" />
                    </div>

                    <div class="col-md-6 mt-3">
                        <input type="text" name="PhoneNumber" class="form-control dark-input"
                               value="@(Model.PhoneNumber ?? "")"
                               placeholder="Phone Number"
                               inputmode="numeric"
                               maxlength="11"
                               pattern="\d{11}"
                               title="Phone number must be exactly 11 digits"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 11)" />
                    </div>

                    <div class="col-md-6 mt-3">
                        <input type="number" name="Age" class="form-control dark-input"
                               value="@(Model.Age > 0 ? Model.Age.ToString() : "")"
                               min="1" max="120"
                               placeholder="Age" />
                    </div>

                    <div class="col-12 mt-3">
                        <input type="text" name="Address" class="form-control dark-input"
                               value="@(Model.Address ?? "")"
                               placeholder="Address" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-5 pt-3">
                    <button type="submit" class="btn btn-dark-action">
                        Update Profile
                    </button>
                    <a asp-action="ChangePassword" class="btn btn-dark-cancel">
                        Change Password
                    </a>
                    <a href="javascript:history.back()" class="btn btn-dark-cancel">
                        Cancel
                    </a>
                </div>


            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('profileImageInput').addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('profilePreview').src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
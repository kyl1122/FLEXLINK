@model IEnumerable<FLEXLINK.Models.Users>

@{
    ViewData["Title"] = "Trainers";
}

<div class="container mt-4">
    <!-- Header Section with Create Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Trainers Management</h2>
            <p class="text-muted mb-0">Manage registered gym trainers and account access.</p>
        </div>
        <a asp-controller="Admin" asp-action="CreateTrainer" class="btn btn-success fw-bold px-3">
            <i class="bi bi-person-plus-fill me-1"></i> Create Trainer Account
        </a>
    </div>

    <!-- Alert Messages -->
    @if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["AdminSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["AdminError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Trainers Card Table (Original Dashboard Blue Card) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2 px-3">
            <div class="fw-bold">
                <i class="bi bi-person-vcard-fill me-2"></i> Trainers
            </div>
            <span class="badge bg-white text-primary rounded-pill fw-bold">@Model.Count()</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    No trainers registered yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-3">Full Name</th>
                                <th>Email</th>
                                <th>Username</th>
                                <th>Date Created</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trainer in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">
                                        <i class="bi bi-person-circle me-2 text-primary"></i>@trainer.FullName
                                    </td>
                                    <td class="text-primary">@trainer.Email</td>
                                    <td>@trainer.UserName</td>
                                    <td class="text-muted small">@trainer.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-outline-primary btn-sm px-3"
                                                    onclick="showTrainerProfile('@trainer.FullName', '@trainer.Email', '@trainer.PhoneNumber', '@trainer.Address', '@trainer.Age', '@(string.IsNullOrEmpty(trainer.ProfilePicture) ? "/uploads/DefaultProfile.png" : trainer.ProfilePicture)', '@trainer.CreatedAt.ToString("MMM dd, yyyy")')">
                                                <i class="bi bi-eye-fill me-1"></i> View
                                            </button>
                                            <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Are you sure you want to delete this trainer?');">
                                                <input type="hidden" name="userId" value="@trainer.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm px-3">
                                                    <i class="bi bi-trash-fill me-1"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ── Trainer Profile View Modal ── *@
    <div class="modal fade" id="trainerProfileModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:16px; overflow:hidden;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="trainerProfileName"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center pt-2 pb-4">
                    <img id="trainerProfileImage" src="" alt="Profile Picture"
                         style="width:140px; height:140px; object-fit:cover; border-radius:50%; margin-bottom:16px;" />
                    <div class="text-start">
                        <p class="mb-2"><i class="bi bi-envelope-fill me-2 text-primary"></i><strong>Email:</strong> <span id="trainerProfileEmail"></span></p>
                        <p class="mb-2"><i class="bi bi-telephone-fill me-2 text-primary"></i><strong>Phone:</strong> <span id="trainerProfilePhone"></span></p>
                        <p class="mb-2"><i class="bi bi-geo-alt-fill me-2 text-primary"></i><strong>Address:</strong> <span id="trainerProfileAddress"></span></p>
                        <p class="mb-2"><i class="bi bi-person-fill me-2 text-primary"></i><strong>Age:</strong> <span id="trainerProfileAge"></span></p>
                        <p class="mb-0"><i class="bi bi-calendar-check-fill me-2 text-primary"></i><strong>Joined:</strong> <span id="trainerProfileCreated"></span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            function showTrainerProfile(name, email, phone, address, age, pic, created) {
                document.getElementById('trainerProfileName').textContent = name;
                document.getElementById('trainerProfileEmail').textContent = email || '—';
                document.getElementById('trainerProfilePhone').textContent = phone || '—';
                document.getElementById('trainerProfileAddress').textContent = address || '—';
                document.getElementById('trainerProfileAge').textContent = age || '—';
                document.getElementById('trainerProfileCreated').textContent = created;
                document.getElementById('trainerProfileImage').src = pic;

                var modal = new bootstrap.Modal(document.getElementById('trainerProfileModal'));
                modal.show();
            }
        </script>
    }

</div>
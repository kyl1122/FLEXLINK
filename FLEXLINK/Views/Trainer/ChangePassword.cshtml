@using FLEXLINK.ViewModels;
@model TrainerChangePasswordViewModel;
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<head>
    <link rel="stylesheet" href="~/css/Trainer_EditProfile.css" />
</head>

<div class="edit-profile-wrapper">
    <h2 class="edit-profile-title">CHANGE PASSWORD</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="ChangePassword" method="post" style="max-width: 500px;">
        @Html.AntiForgeryToken()

        <div class="field-item mb-3">
            <label asp-for="CurrentPassword" class="form-label text-light"></label>
            <input asp-for="CurrentPassword" class="form-control" placeholder="Current Password" />
            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
        </div>

        <div class="field-item mb-3">
            <label asp-for="NewPassword" class="form-label text-light"></label>
            <input asp-for="NewPassword" class="form-control" placeholder="New Password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="field-item mb-3">
            <label asp-for="ConfirmNewPassword" class="form-label text-light"></label>
            <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Confirm New Password" />
            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
        </div>

        <div class="profile-actions">
            <button type="submit" class="btn-update-profile">Update Password</button>
            <a asp-action="EditProfile" class="btn-cancel-profile text-decoration-none">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
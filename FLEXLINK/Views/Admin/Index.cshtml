@using FLEXLINK.Models
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Dark Theme & Container Matching Reference Design */
    body {
        background-color: #232228 !important;
        color: #ffffff;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }

    .dark-panel {
        background-color: #272a34;
        border-radius: 12px;
        border: none;
        color: #ffffff;
    }

    .text-green-accent {
        color: #00c853 !important;
    }

    .text-red-accent {
        color: #e53935 !important;
    }

    .pill-btn-red {
        border: 1px solid #e53935;
        color: #e53935;
        background: transparent;
        border-radius: 50rem;
        padding: 2px 10px;
        font-size: 0.72rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease-in-out;
    }

        .pill-btn-red:hover {
            background-color: #e53935;
            color: #ffffff;
        }

    /* Custom Capacity Bar */
    .progress-bar-bg {
        background-color: #d8dadf;
        border-radius: 20px;
        height: 18px;
    }

    .progress-bar-fill {
        background-color: #00c853;
        border-radius: 20px;
    }

    /* Header Bar */
    .monthly-header {
        background-color: #1bb954;
        color: #ffffff;
        border-radius: 10px 10px 0 0;
        padding: 10px 18px;
    }

    .monthly-badge {
        background-color: #ffffff;
        color: #000000;
        border-radius: 50rem;
        padding: 2px 14px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-block;
        min-width: 80px;
        height: 22px;
    }

    /* Table & Container Styling Matching Admin_3.jpg */
    .table-container-dark {
        background-color: #272a34;
        border-radius: 12px;
        overflow: hidden;
    }

    .custom-dark-table {
        color: #000;
        margin-bottom: 0;
        background-color: transparent;
    }

        .custom-dark-table tr {
            border-bottom: 1px solid #333846;
        }

        .custom-dark-table td {
            border: none;
            color: #000;
            padding-top: 16px;
            padding-bottom: 16px;
            vertical-align: middle;
        }

    .badge-pill-outline {
        border: 1px solid #e53935;
        color: #e53935;
        border-radius: 50rem;
        padding: 2px 10px;
        font-size: 0.72rem;
        background: transparent;
        display: inline-block;
    }

    .equipment-pending {
        margin-left: 20px;
    }
</style>

<div class="container-fluid px-4 mt-3">

    @* ── HEADER ── *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1 text-black fs-2">Admin Dashboard</h1>
            <p class="text-black mb-0">Manage all users, trainers, and gym equipment</p>
        </div>
        <a asp-controller="Admin" asp-action="CreateTrainer" class="btn btn-success fw-semibold px-3 py-2" style="border-radius: 8px; background-color: #1bb954; border: none;">
            <i class="bi bi-person-plus me-1"></i> Create Trainer Account
        </a>
    </div>

    @* Alerts *@
    @if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bg-success text-white border-0">
            <i class="bi bi-check-circle me-1"></i> @TempData["AdminSuccess"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show bg-danger text-white border-0">
            <i class="bi bi-exclamation-circle me-1"></i> @TempData["AdminError"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ── ROW 1: CAPACITY, TRAINERS, USERS ── *@
    @{
        int currentCount = ViewBag.CurrentCount;
        int maxCapacity = ViewBag.MaxCapacity;
        bool isFull = currentCount >= maxCapacity;
        double percent = maxCapacity > 0 ? Math.Round((double)currentCount / maxCapacity * 100, 0) : 0;
    }

    <div class="row g-3 mb-3">
        <!-- Space Capacity Card -->
        <div class="col-lg-5">
            <div class="card dark-panel p-3 h-100 justify-content-center">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fw-semibold d-flex align-items-center">
                        <i class="bi bi-people-fill me-2 fs-5"></i>Space Capacity (Today)
                    </span>
                    <span class="fw-bold text-red-accent fs-5">
                        @currentCount/@maxCapacity
                    </span>
                </div>
                <div class="progress progress-bar-bg">
                    <div class="progress-bar progress-bar-fill"
                         role="progressbar"
                         style="width: @percent%;"
                         aria-valuenow="@currentCount" aria-valuemin="0" aria-valuemax="@maxCapacity">
                    </div>
                </div>
                @if (isFull)
                {
                    <p class="text-red-accent small mt-2 mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        Gym is at full capacity. Staff cannot check in any more members or guests.
                    </p>
                }
            </div>
        </div>

        <!-- Trainers Card -->
        <div class="col-lg-3 col-md-6">
            <div class="card dark-panel p-3 h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person me-2 fs-5"></i>
                        <span class="fw-semibold">Trainers</span>
                    </div>
                    <a asp-controller="Admin" asp-action="Trainers" class="pill-btn-red">
                        View Trainer <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="mt-auto d-flex align-items-baseline">
                    <span class="display-5 fw-bold text-red-accent me-2">@ViewBag.TrainerCount</span>
                    <span class="text-red-accent fw-semibold">Total</span>
                </div>
            </div>
        </div>

        <!-- Users Card -->
        <div class="col-lg-4 col-md-6">
            <div class="card dark-panel p-3 h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person me-2 fs-5"></i>
                        <span class="fw-semibold">Users</span>
                    </div>
                    <a asp-controller="Admin" asp-action="Users" class="pill-btn-red">
                        View User <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="mt-auto d-flex align-items-baseline">
                    <span class="display-5 fw-bold text-red-accent me-2">@ViewBag.UserCount</span>
                    <span class="text-red-accent fw-semibold">Total</span>
                </div>
            </div>
        </div>
    </div>

    @* ── ROW 2: ALL-TIME INCOME & EQUIPMENT ── *@
    <div class="row g-3 mb-4">
        <!-- All-Time Income Card -->
        <div class="col-lg-5">
            <div class="card dark-panel p-3 h-100 justify-content-center">
                <div class="d-flex align-items-center mb-1">
                    <i class="bi bi-credit-card-2-front me-2 fs-5"></i>
                    <span class="fw-semibold">All - Time Income</span>
                </div>
                <div class="display-5 fw-bold text-green-accent ms-1 mt-1">
                    ₱ @(((decimal)ViewBag.TotalIncome).ToString("N0"))
                </div>
            </div>
        </div>

        <!-- Equipment Card -->
        <div class="col-lg-7">
            <div class="card dark-panel p-3 h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person me-2 fs-5"></i>
                        <span class="fw-semibold">Equipment</span>
                    </div>
                    <a asp-controller="Admin" asp-action="Equipment" class="pill-btn-red">
                        View Trainer <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="mt-auto d-flex align-items-baseline">
                    <span class="display-5 fw-bold text-red-accent me-2">@ViewBag.EquipmentCount</span>
                    <span class="text-red-accent fw-semibold me-4">Total</span>
                    @if ((int)ViewBag.PendingRepairCount > 0)
                    {
                        <div class="equipment-pending d-inline-flex align-items-baseline">
                            <span class="text-red-accent fw-bold fs-3 me-1">@ViewBag.PendingRepairCount</span>
                            <span class="text-red-accent fw-semibold">- Pending</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── INCOME REPORTS TABLE ── *@
    @{
        var monthlyIncome = ViewBag.MonthlyIncome as List<FLEXLINK.ViewModels.MonthlyIncomeViewModel> ?? new();
    }
    <div class="table-container-dark mb-4">
        <div class="monthly-header d-flex justify-content-between align-items-center">
            <span class="fw-bold fs-5 d-flex align-items-center">
                <i class="bi bi-graph-up me-2"></i> Monthly Income Breakdown
            </span>
            <span class="monthly-badge">This Month: ₱ @(((decimal)ViewBag.CurrentMonthIncome).ToString("N0"))</span>
        </div>
        <div class="p-0">
            @if (!monthlyIncome.Any())
            {
                <p class="text-secondary text-center py-4 mb-0">
                    <i class="bi bi-inbox me-1"></i>No approved memberships yet.
                </p>
            }
            else
            {
                <table class="table custom-dark-table align-middle mb-0">
                    <tbody>
                        @{
                            int rowIndex = 0;
                        }
                        @foreach (var row in monthlyIncome)
                        {
                            rowIndex++;
                            string collapseId = $"monthDetail{rowIndex}";
                            <tr style="cursor:pointer;" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                <td class="ps-4" style="width: 35%;">
                                    <i class="bi bi-calendar3 me-3 text-white fs-5"></i>
                                    <span class="fs-6">@row.MonthLabel</span>
                                </td>
                                <td class="text-center" style="width: 15%;">
                                    <span>@row.MembershipCount</span>
                                </td>
                                <td class="text-center" style="width: 25%;">
                                    @if (row.OneMonthCount > 0)
                                    {
                                        <span class="badge-pill-outline me-1">1mo × @row.OneMonthCount</span>
                                    }
                                    @if (row.TwoMonthCount > 0)
                                    {
                                        <span class="badge-pill-outline me-1">2mo × @row.TwoMonthCount</span>
                                    }
                                    @if (row.ThreeMonthCount > 0)
                                    {
                                        <span class="badge-pill-outline">3mo × @row.ThreeMonthCount</span>
                                    }
                                </td>
                                <td class="text-end pe-4 fw-bold text-green-accent fs-5" style="width: 25%;">
                                    ₱ @row.Total.ToString("N0")
                                </td>
                            </tr>
                            <tr class="collapse" id="@collapseId">
                                <td colspan="4" class="p-0" style="background-color: #1f222b;">
                                    <table class="table table-sm custom-dark-table mb-0">
                                        <thead>
                                            <tr class="small text-secondary">
                                                <th class="ps-5">Member</th>
                                                <th>Plan</th>
                                                <th>Start Date</th>
                                                <th>Expiry Date</th>
                                                <th class="text-end pe-4">Price</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var detail in row.Details)
                                            {
                                                <tr>
                                                    <td class="ps-5">@detail.UserName</td>
                                                    <td>@detail.PlanLabel</td>
                                                    <td>@detail.StartDate.ToString("MMM dd, yyyy")</td>
                                                    <td>@detail.ExpiryDate.ToString("MMM dd, yyyy")</td>
                                                    <td class="text-end pe-4 text-green-accent">₱ @detail.Price.ToString("N0")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

</div>

@* ── Delete User Confirmation Modal ── *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-panel">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete the account for
                <strong id="deleteUserEmail"></strong>?
                <br />
                <span class="text-red-accent small">This action cannot be undone. All their data will be removed.</span>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-controller="Admin" asp-action="DeleteUser" method="post" id="deleteForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" id="deleteUserId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Yes, Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('deleteUserId').value = button.getAttribute('data-user-id');
            document.getElementById('deleteUserEmail').textContent = button.getAttribute('data-user-email');
        });
    </script>
}
@{
    ViewData["Title"] = "User Dashboard";
}
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/User_Dashboard.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
</head>

<div class="container-fluid dashboard-container py-4 px-md-5">

    @if (ViewBag.ShowExpiryAlert == true)
    {
        <div id="expiryAlertOverlay" class="expiry-alert-overlay">
            <div class="expiry-alert-modal">
                <div class="expiry-alert-icon fs-1">⏰</div>
                <h3 class="fs-2 fw-bold">Your Membership is Expiring Soon</h3>
                <p class="fs-5">
                    Your FlexLink membership will expire on
                    <strong>@ViewBag.ExpiryDate.ToString("MMMM dd, yyyy")</strong>
                    (@ViewBag.DaysRemaining day@(((int)ViewBag.DaysRemaining) == 1 ? "" : "s") left).
                    Renew now to avoid losing access to the gym and trainer booking.
                </p>
                <div class="expiry-alert-actions">
                    <a href="@Url.Action("Membership", "Home")" class="expiry-alert-btn-primary btn-lg">Renew Now</a>
                    <button type="button" class="expiry-alert-btn-secondary btn-lg" onclick="dismissExpiryAlert()">Remind Me Later</button>
                </div>
            </div>
        </div>

        <script>
            function dismissExpiryAlert() {
                document.getElementById('expiryAlertOverlay').style.display = 'none';
                sessionStorage.setItem('expiryAlertDismissed', 'true');
            }
            document.addEventListener('DOMContentLoaded', function () {
                if (sessionStorage.getItem('expiryAlertDismissed') === 'true') {
                    var overlay = document.getElementById('expiryAlertOverlay');
                    if (overlay) overlay.style.display = 'none';
                }
            });
        </script>
    }

    @if (User.Identity.IsAuthenticated && User.IsInRole("User"))
    {
        <!-- Hero Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="dashboard-hero">
                    <h1 class="display-5 fw-bold mb-2">Hello @User.Identity.Name</h1>
                    <p class="hero-subtitle fs-4 mb-0">Welcome to Flexlink portal. Track your progress and manage your sessions below</p>
                </div>
            </div>
        </div>

        <!-- Action Cards Grid -->
        <div class="row g-4">
            <!-- Our Trainers Card -->
            <div class="col-md-6">
                <div class="card dashboard-card h-100">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-person me-2 fs-3 text-light"></i>
                                <h3 class="card-title fw-semibold mb-0 fs-3">Our Trainers</h3>
                            </div>
                            <p class="card-text fs-5 mb-4">Connect with professional trainers to reach your fitness goals.</p>
                        </div>
                        <a asp-controller="Home" asp-action="Trainer" class="btn btn-outline-danger custom-dash-btn btn-lg w-100">
                            View Trainer <i class="bi bi-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Membership Card -->
            <div class="col-md-6">
                <div class="card dashboard-card h-100">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-credit-card me-2 fs-3 text-light"></i>
                                <h3 class="card-title fw-semibold mb-0 fs-3">Membership</h3>
                            </div>
                            <p class="card-text fs-5 mb-4">View your current plan details and billing information.</p>
                        </div>
                        <a asp-controller="Home" asp-action="Membership" class="btn btn-outline-danger custom-dash-btn btn-lg w-100">
                            Manage plan <i class="bi bi-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- My Schedule Card -->
            <div class="col-md-6">
                <div class="card dashboard-card h-100">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-calendar3 me-2 fs-3 text-light"></i>
                                <h3 class="card-title fw-semibold mb-0 fs-3">My Schedule</h3>
                            </div>
                            <p class="card-text fs-5 mb-4">Check your upcoming workout session history.</p>
                        </div>
                        <a asp-controller="Home" asp-action="Schedule" class="btn btn-outline-danger custom-dash-btn btn-lg w-100">
                            View Schedule <i class="bi bi-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

</div>
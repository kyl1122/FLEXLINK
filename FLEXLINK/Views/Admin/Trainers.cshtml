@model IEnumerable<FLEXLINK.Models.Users>

@{
    ViewData["Title"] = "Trainers";
}
<head>
    <link rel="stylesheet" href="~/css/Admin_Trainer.css" />
</head>

<div class="container-fluid py-4 dashboard-container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 dashboard-title">Trainers Management</h2>
            <p class="mb-0 dashboard-subtitle">Manage registered gym trainers and account access.</p>
        </div>
        <a asp-controller="Admin" asp-action="CreateTrainer" class="btn-black-pill">
            <i class="bi bi-plus-circle-fill"></i> Create Trainer Account
        </a>
    </div>

    <!-- Alert Messages -->
    @if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success bg-dark text-success border-success alert-dismissible fade show mb-4" role="alert">
            @TempData["AdminSuccess"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger bg-dark text-danger border-danger alert-dismissible fade show mb-4" role="alert">
            @TempData["AdminError"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- External Light Gray Search Bar -->
    <div class="mb-4">
        <div class="input-group search-input-group py-1 px-2">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" id="trainerSearchInput" class="form-control"
                   placeholder="Search by name, email, or username..." onkeyup="filterTrainers()" />
        </div>
    </div>

    <!-- Main Container Card -->
    <div class="card dark-table-card shadow-sm mb-4 overflow-hidden">
        <div class="table-card-topbar">
            <span class="card-topbar-title">Trainers</span>
            <span class="badge-count">@Model.Count()</span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-secondary">
                    <i class="bi bi-inbox me-1"></i> No trainers registered yet.
                </div>
            }
            else
            {
                <div id="noTrainerResults" class="text-center py-5 text-secondary" style="display:none;">
                    <i class="bi bi-search me-1"></i> No trainers match your search.
                </div>
                <div class="table-responsive">
                    <table class="table table-custom table-hover align-middle" id="trainersTable">
                        <thead>
                            <tr>
                                <th class="ps-4">Full Name</th>
                                <th>Email</th>
                                <th>Username</th>
                                <th>Date Created</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trainer in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-white">@trainer.FullName</td>
                                    <td class="text-white">@trainer.Email</td>
                                    <td class="text-white">@trainer.UserName</td>
                                    <td class="text-white">@trainer.CreatedAt.ToString("MMMM dd, yyyy")</td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2">
                                            <button type="button" class="btn btn-action-view"
                                                    onclick="showTrainerProfile('@trainer.FullName', '@trainer.Email', '@trainer.PhoneNumber', '@trainer.Address', '@trainer.Age', '@(string.IsNullOrEmpty(trainer.ProfilePicture) ? "/uploads/DefaultProfile.png" : trainer.ProfilePicture)', '@trainer.CreatedAt.ToString("MMMM dd, yyyy")')">
                                                <i class="bi bi-eye-fill me-1"></i> View
                                            </button>
                                            <form asp-action="DeleteUser" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this trainer?');">
                                                <input type="hidden" name="userId" value="@trainer.Id" />
                                                <button type="submit" class="btn btn-action-delete">
                                                    <i class="bi bi-trash-fill me-1"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="trainerProfileModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content dark-modal overflow-hidden">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-white" id="trainerProfileName"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center pt-2 pb-4">
                    <img id="trainerProfileImage" src="" alt="Profile Picture"
                         style="width:120px; height:120px; object-fit:cover; border-radius:50%; margin-bottom:16px;" />
                    <div class="text-start px-4">
                        <p class="mb-2"><strong class="text-white">Email:</strong> <span id="trainerProfileEmail" class="text-secondary"></span></p>
                        <p class="mb-2"><strong class="text-white">Phone:</strong> <span id="trainerProfilePhone" class="text-secondary"></span></p>
                        <p class="mb-2"><strong class="text-white">Address:</strong> <span id="trainerProfileAddress" class="text-secondary"></span></p>
                        <p class="mb-2"><strong class="text-white">Age:</strong> <span id="trainerProfileAge" class="text-secondary"></span></p>
                        <p class="mb-0"><strong class="text-white">Joined:</strong> <span id="trainerProfileCreated" class="text-secondary"></span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            function filterTrainers() {
                const query = document.getElementById('trainerSearchInput').value.toLowerCase();
                const rows = document.querySelectorAll('#trainersTable tbody tr');
                let visibleCount = 0;

                rows.forEach(function (row) {
                    const text = row.innerText.toLowerCase();
                    const match = text.includes(query);
                    row.style.display = match ? '' : 'none';
                    if (match) visibleCount++;
                });

                document.getElementById('noTrainerResults').style.display = visibleCount === 0 ? '' : 'none';
            }

            function showTrainerProfile(name, email, phone, address, age, pic, created) {
                document.getElementById('trainerProfileName').textContent = name;
                document.getElementById('trainerProfileEmail').textContent = email || '—';
                document.getElementById('trainerProfilePhone').textContent = phone || '—';
                document.getElementById('trainerProfileAddress').textContent = address || '—';
                document.getElementById('trainerProfileAge').textContent = age || '—';
                document.getElementById('trainerProfileCreated').textContent = created;
                document.getElementById('trainerProfileImage').src = pic;

                var modal = new bootstrap.Modal(document.getElementById('trainerProfileModal'));
                modal.show();
            }
        </script>
    }
</div>
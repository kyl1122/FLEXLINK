@model List<FLEXLINK.Models.Equipment>
@using FLEXLINK.Models
@{
    ViewData["Title"] = "Equipment Management";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var repairNotes = ViewBag.RepairNotes as List<EquipmentRepairNote> ?? new List<EquipmentRepairNote>();
}

<head>
    <link rel="stylesheet" href="~/css/Admin_Trainer.css" />
</head>

<div class="container-fluid py-4 dashboard-container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-1 dashboard-title">Equipment Management</h2>
            <p class="mb-0 dashboard-subtitle">Manage gym equipment and repair reports.</p>
        </div>
        <button class="btn-black-pill" data-bs-toggle="modal" data-bs-target="#addEquipmentModal">
            <i class="bi bi-plus-circle-fill"></i> Add Equipment
        </button>
    </div>

    <!-- External Light Gray Search Bar (Moved directly under subtext) -->
    <div class="mb-4">
        <div class="input-group search-input-group py-1 px-2">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" id="equipmentSearchInput" class="form-control"
                   placeholder="Search by name or description..." onkeyup="filterEquipment()" />
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success bg-dark text-success border-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["AdminSuccess"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger bg-dark text-danger border-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-circle me-1"></i> @TempData["AdminError"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ── EQUIPMENT REPAIR REPORTS ── -->
    @if (repairNotes.Any())
    {
        <div class="card dark-table-card shadow-sm mb-4 overflow-hidden border-danger" style="border: 1px solid #dc3545 !important;">
            <div class="table-card-topbar bg-danger text-white">
                <span class="card-topbar-title text-white">
                    <i class="bi bi-exclamation-triangle me-2"></i>Equipment Repair Reports
                </span>
                <span class="badge bg-white text-danger fw-bold rounded-2 px-2 py-1 fs-6">@repairNotes.Count pending</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-custom table-hover align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4">Equipment</th>
                                <th>Reported By</th>
                                <th>Issue</th>
                                <th>Date Reported</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var note in repairNotes)
                            {
                                <tr>
                                    <td class="ps-4 text-white">
                                        <i class="bi bi-wrench-adjustable text-danger me-2"></i>
                                        <strong>@note.Equipment?.Name</strong>
                                    </td>
                                    <td class="text-white">
                                        <i class="bi bi-person-circle text-secondary me-1"></i>
                                        @note.TrainerName
                                    </td>
                                    <td class="text-white">@note.Note</td>
                                    <td class="text-secondary small">@note.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</td>
                                    <td class="text-end pe-4">
                                        <form asp-controller="Admin" asp-action="MarkRepaired" method="post" class="d-inline"
                                              onsubmit="return confirm('Mark this equipment as repaired?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="noteId" value="@note.Id" />
                                            <button type="submit" class="btn btn-action-view" style="background-color: #198754;">
                                                <i class="bi bi-check-lg me-1"></i> Repaired
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success bg-dark text-success border-success d-flex align-items-center mb-4">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <span>No equipment repair reports pending. All equipment is in good condition!</span>
        </div>
    }

    <!-- ── EQUIPMENT MANAGEMENT TABLE ── -->
    <div class="card dark-table-card shadow-sm mb-4 overflow-hidden">
        <div class="table-card-topbar">
            <span class="card-topbar-title"><i class="bi bi-tools me-2"></i>Equipment List</span>
            <span class="badge-count">@Model.Count()</span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-secondary">
                    <i class="bi bi-inbox me-1"></i> No equipment added yet. Click "Add Equipment" to get started.
                </div>
            }
            else
            {
                <div id="noEquipmentResults" class="text-center py-5 text-secondary" style="display:none;">
                    <i class="bi bi-search me-1"></i> No equipment matches your search.
                </div>
                <div class="table-responsive">
                    <table class="table table-custom table-hover align-middle" id="equipmentTable">
                        <thead>
                            <tr>
                                <th class="ps-4">Equipment Name</th>
                                <th>Description</th>
                                <th>Date Added</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var eq in Model)
                            {
                                bool needsRepair = eq.RepairNotes.Any();
                                <tr>
                                    <td class="ps-4 text-white">
                                        <i class="bi bi-wrench-adjustable @(needsRepair ? "text-danger" : "text-success") me-2"></i>
                                        <strong>@eq.Name</strong>
                                    </td>
                                    <td class="text-secondary small">@(eq.Description ?? "—")</td>
                                    <td class="text-white">@eq.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (needsRepair)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-exclamation-triangle me-1"></i>@eq.RepairNotes.Count report(s)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>OK
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <form asp-controller="Admin" asp-action="DeleteEquipment" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete equipment \'@eq.Name\'? All its repair notes will also be removed.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="equipmentId" value="@eq.Id" />
                                            <button type="submit" class="btn btn-action-delete">
                                                <i class="bi bi-trash-fill me-1"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- ── Add Equipment Modal ── -->
<div class="modal fade" id="addEquipmentModal" tabindex="-1" aria-labelledby="addEquipmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal overflow-hidden">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-white" id="addEquipmentModalLabel">
                    <i class="bi bi-tools me-2"></i>Add New Equipment
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="AddEquipment" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body pt-3 pb-4">
                    <div class="mb-3">
                        <label for="equipName" class="form-label text-white fw-semibold">Equipment Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control bg-dark text-white border-secondary" id="equipName" name="name"
                               placeholder="e.g. Treadmill, Barbell, Bench Press" required maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label for="equipDesc" class="form-label text-white fw-semibold">Description <span class="text-secondary small">(optional)</span></label>
                        <textarea class="form-control bg-dark text-white border-secondary" id="equipDesc" name="description" rows="3"
                                  placeholder="e.g. Commercial-grade treadmill, Zone A" maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-black-pill border border-secondary">
                        <i class="bi bi-plus-circle-fill"></i> Add Equipment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterEquipment() {
            const query = document.getElementById('equipmentSearchInput').value.toLowerCase();
            const rows = document.querySelectorAll('#equipmentTable tbody tr');
            let visibleCount = 0;

            rows.forEach(function (row) {
                const text = row.innerText.toLowerCase();
                const match = text.includes(query);
                row.style.display = match ? '' : 'none';
                if (match) visibleCount++;
            });

            document.getElementById('noEquipmentResults').style.display = visibleCount === 0 ? '' : 'none';
        }
    </script>
}
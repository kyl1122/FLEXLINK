@model List<FLEXLINK.Models.Equipment>
@{
    ViewData["Title"] = "Gym Equipment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<head>
    <link rel="stylesheet" href="~/css/Trainers_Equipment.css" />
</head>

<div class="dashboard-header mb-4">
    <div class="container-fluid">
        <a asp-controller="Trainer" asp-action="Index" class="text-decoration-none mb-2 d-inline-block" style="color: #f8f9fa;">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>
        <h1 class="dashboard-title m-0">Gym Equipment</h1>
        <p class="text-decoration-none mb-2 d-inline-block" style="color: #f8f9fa">All equipment currently tracked in the system.</p>
    </div>
</div>

<div class="container-fluid px-4">

    @if (TempData["EquipmentSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle me-2"></i> @TempData["EquipmentSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["EquipmentError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i> @TempData["EquipmentError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="dashboard-card p-5 text-center text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
            <span>No equipment added yet. Ask the admin to add equipment.</span>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var item in Model)
            {
                <div class="dashboard-card p-3">
                    @await Html.PartialAsync("_EquipmentRow", item)
                </div>
            }
        </div>
    }

</div>

@* ── Repair Note Modal ── *@
<div class="modal fade" id="repairModal" tabindex="-1" aria-labelledby="repairModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title" id="repairModalLabel">
                    <i class="bi bi-wrench me-2"></i>Report Repair Needed
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Trainer" asp-action="AddRepairNote" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="equipmentId" id="repairEquipmentId" />
                <div class="modal-body">
                    <p class="mb-3">
                        Equipment: <strong id="repairEquipmentName" class="text-warning"></strong>
                    </p>
                    <div class="mb-3">
                        <label for="noteInput" class="form-label fw-semibold">Describe the issue</label>
                        <textarea class="form-control" id="noteInput" name="note" rows="3"
                                  placeholder="e.g. Treadmill belt is slipping, needs lubrication..."
                                  required maxlength="1000"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-send me-1"></i>Submit Report
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('repairModal').addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('repairEquipmentId').value = btn.getAttribute('data-equipment-id');
            document.getElementById('repairEquipmentName').textContent = btn.getAttribute('data-equipment-name');
            document.getElementById('noteInput').value = '';
        });
    </script>
}
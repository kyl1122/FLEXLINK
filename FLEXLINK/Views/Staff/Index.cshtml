@using FLEXLINK.ViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Staff Check-In";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int currentCount = ViewBag.CurrentCount;
    int maxCapacity = ViewBag.MaxCapacity;
    bool isFull = ViewBag.IsFull;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int pendingPaymentsCount = ViewBag.PendingPaymentsCount ?? 0;
    double percent = maxCapacity > 0 ? Math.Round((double)currentCount / maxCapacity * 100, 0) : 0;

    string? memberName = TempData["MemberCheckInName"] as string;
    string? memberEmail = TempData["MemberCheckInEmail"] as string;
    string? memberPic = TempData["MemberCheckInPic"] as string;
    string? memberStatus = TempData["MemberCheckInStatus"] as string;
    string? expiryDate = TempData["MemberExpiryDate"] as string;
    string? memberId = ViewBag.CheckedInUserId as string;

    string displayPic = !string.IsNullOrWhiteSpace(memberPic) ? memberPic : "/uploads/default-avatar.png";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/Staff_Index.css" />

<!-- Force dark background on parent body tag directly from view -->
<style>
    html, body, main, .container, .container-fluid, .content-wrapper, .pb-3 {
        background-color: #2B2929 !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        min-height: 100vh !important;
    }
</style>

<!-- Floating Top-Center System Notifications -->
@if (TempData["AttendanceSuccess"] != null && string.IsNullOrEmpty(memberName))
{
    <div class="alert alert-success alert-dismissible fade show border-0 toast-notification" role="alert" style="background: #10b981; color: #fff; border-radius: 12px;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["AttendanceSuccess"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["AttendanceError"] != null && string.IsNullOrEmpty(memberName))
{
    <div class="alert alert-danger alert-dismissible fade show border-0 toast-notification" role="alert" style="background: #FF3333; color: #fff; border-radius: 12px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["AttendanceError"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(memberName))
{
    bool isActive = memberStatus == "Active";

    <div class="floating-card-backdrop" id="cardBackdrop" onclick="closeProfileModal()"></div>

    <div id="checkInFloatingCard" class="card border-0 floating-status-card p-3"
         style="background: #222020; border-top: 8px solid @(isActive ? "#10b981" : "#FF3333") !important; color: #ffffff;">

        <div class="card-body p-4 p-md-5">
            <button type="button" class="btn-close btn-close-white" onclick="closeProfileModal()" aria-label="Close" style="font-size: 1.2rem; position: absolute; top: 24px; right: 24px; z-index: 10;"></button>

            <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-start text-center text-sm-start">
                <div class="avatar-wrapper-xl me-0 me-sm-4 mb-3 mb-sm-0 flex-shrink-0 shadow-lg"
                     style="border: 4px solid @(isActive ? "#10b981" : "#FF3333");"
                     onclick="openProfileLightbox('@displayPic')"
                     title="Click to view full image">
                    <img src="@displayPic"
                         alt="@memberName"
                         onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    <div style="display: none;" class="w-100 h-100 align-items-center justify-content-center bg-dark text-secondary">
                        <i class="bi bi-person-fill" style="font-size: 4rem;"></i>
                    </div>
                </div>

                <div class="flex-grow-1 w-100">
                    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between mb-2">
                        <h2 class="fw-bolder mb-1 text-white" style="font-size: 2rem;">@memberName</h2>
                        <span class="badge @(isActive ? "bg-success" : "bg-danger") px-3 py-2 fs-6" style="letter-spacing: 0.5px; border-radius: 10px;">
                            @(isActive ? "ACTIVE MEMBERSHIP" : "NO ACTIVE PLAN")
                        </span>
                    </div>

                    <p class="text-secondary mb-3 fs-5">@memberEmail</p>

                    @if (isActive)
                    {
                        <div class="p-3 text-success fw-bold d-flex align-items-center justify-content-center justify-content-sm-start fs-5" style="background-color: rgba(16, 185, 129, 0.1); border-radius: 12px;">
                            <i class="bi bi-check-circle-fill me-2 fs-4"></i> Valid until @expiryDate
                        </div>
                    }
                    else
                    {
                        <div class="p-3 text-danger fw-bold d-flex align-items-center justify-content-center justify-content-sm-start fs-5 mb-3" style="background-color: rgba(255, 51, 51, 0.1); border-radius: 12px;">
                            <i class="bi bi-x-circle-fill me-2 fs-4"></i> Check-in restricted (No active membership)
                        </div>

                        <form asp-controller="Staff" asp-action="AddMembershipQuick" method="post"
                              class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2 p-3"
                              style="background-color: #1a1818; border-radius: 12px;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@memberId" />
                            <label class="fw-semibold text-nowrap me-sm-2 mb-0 text-white">Add Membership:</label>
                            <select name="months" class="form-select form-select-sm dark-input-pill" style="max-width: 160px;">
                                <option value="1">1 Month</option>
                                <option value="2">2 Months</option>
                                <option value="3">3 Months</option>
                            </select>
                            <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3" style="background-color: #FF3333; border: none;">
                                <i class="bi bi-plus-circle me-1"></i> Grant Membership
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
}

<div class="staff-dashboard-wrapper" style="background-color: #2B2929; min-height: 100vh; padding: 2.5rem 3.5rem;">
    <!-- Header Section -->
    <div class="mb-4">
        <h1 class="page-title mb-1">Staff Check - In</h1>
        <p class="page-subtitle mb-0">Check in members or guest as they arrive at the gym.</p>
    </div>

    <!-- Top Cards Grid -->
    <div class="row g-3 mb-3">
        <!-- Registration Requests Card -->
        <div class="col-md-6">
            <div class="card dark-panel-card h-100 p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-bell-fill text-white fs-6"></i>
                        <span class="card-label-text">Registration Requests</span>
                    </div>
                    <a asp-controller="Staff" asp-action="SpaceCapacity" class="pill-badge-btn">
                        View Trainer <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="d-flex align-items-baseline gap-2 mt-1">
                    <span class="stat-number-red">@pendingCount</span>
                    <span class="stat-label-red">Pending</span>
                </div>
            </div>
        </div>

        <!-- Membership Payment Request Card -->
        <div class="col-md-6">
            <div class="card dark-panel-card h-100 p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-credit-card-fill text-white fs-6"></i>
                        <span class="card-label-text">Membership Payment Request</span>
                    </div>
                    <a asp-controller="Staff" asp-action="SpaceCapacity" class="pill-badge-btn">
                        View Trainer <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="d-flex align-items-baseline gap-2 mt-1">
                    <span class="stat-number-red">@pendingPaymentsCount</span>
                    <span class="stat-label-red">Pending</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Space Capacity Bar Card -->
    <div class="card dark-panel-card p-3 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-white fs-6"></i>
                <span class="card-label-text">Space Capacity (Today)</span>
            </div>
            <span class="stat-number-red fs-5 fw-bold">
                @currentCount/@maxCapacity
            </span>
        </div>
        <div class="capacity-progress-track">
            <div class="capacity-progress-fill" style="width: @percent%; background-color: #10b981 !important;"></div>
        </div>
        @if (isFull)
        {
            <p class="stat-label-red small mt-2 mb-0">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> Gym is at full capacity. Check-ins temporarily restricted.
            </p>
        }
    </div>

    <!-- Member Check-In Main Form Card -->
    <div class="card dark-panel-card p-4 mb-3">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <h5 class="section-title-red mb-0">Member Check - In</h5>
            <i class="bi bi-people-fill icon-red fs-3"></i>
        </div>

        <form asp-controller="Staff" asp-action="MemberLogin" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Email" class="form-label field-label mb-2">Member Email</label>
                <input asp-for="Email" class="form-control dark-input-pill" placeholder="Member@Gmail.com" required />
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <button type="submit" class="btn btn-dark-action w-100" @(isFull ? "disabled" : "")>
                        <i class="bi bi-box-arrow-in-right me-1"></i> Check In Member
                    </button>
                </div>
                <div class="col-md-6">
                    <button type="submit" asp-action="CheckOutMember" class="btn btn-red-outline w-100">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Guest Access Section Card -->
    <div class="card dark-panel-card p-4">
        <div class="row align-items-center g-3">
            <div class="col-lg-6">
                <h5 class="section-title-red mb-1">No Account ?</h5>
                <p class="field-label mb-0">Walk-In guest can check in without registering.</p>
            </div>
            <div class="col-lg-6">
                <div class="d-flex flex-column gap-2 ms-auto" style="max-width: 380px;">
                    <form asp-controller="Staff" asp-action="GuestLogin" method="post" class="w-100">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-dark-action w-100" @(isFull ? "disabled" : "")>
                            <i class="bi bi-box-arrow-in-right me-1"></i> Login as Guest
                        </button>
                    </form>
                    <form asp-controller="Staff" asp-action="CheckOutGuest" method="post" class="w-100">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-red-outline w-100">
                            <i class="bi bi-box-arrow-right me-1"></i> Sign Out Guest
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function closeProfileModal() {
        var card = document.getElementById('checkInFloatingCard');
        var backdrop = document.getElementById('cardBackdrop');
        if (card) card.remove();
        if (backdrop) backdrop.remove();
        closeProfileLightbox();
    }

    function openProfileLightbox(imageSrc) {
        if (document.getElementById('profileLightbox')) return;
        var lightbox = document.createElement('div');
        lightbox.id = 'profileLightbox';
        lightbox.className = 'profile-lightbox-backdrop';
        lightbox.onclick = closeProfileLightbox;
        lightbox.innerHTML = `
            <div class="profile-lightbox-card" onclick="event.stopPropagation();">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" onclick="closeProfileLightbox()" aria-label="Close"></button>
                <img src="${imageSrc}" class="profile-lightbox-img" alt="Profile Picture Preview" />
            </div>
        `;
        document.body.appendChild(lightbox);
    }

    function closeProfileLightbox() {
        var lightbox = document.getElementById('profileLightbox');
        if (lightbox) lightbox.remove();
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeProfileLightbox();
    });

    // Auto-dismiss floating toast notification after 4 seconds
    document.addEventListener('DOMContentLoaded', function () {
        const toasts = document.querySelectorAll('.toast-notification');
        toasts.forEach(toast => {
            setTimeout(() => {
                toast.classList.add('toast-hide');
                toast.addEventListener('animationend', () => {
                    toast.remove();
                });
            }, 4000);
        });
    });
</script>